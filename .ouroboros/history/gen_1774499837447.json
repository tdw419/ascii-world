  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.28)*18+Math.cos(y*0.013-t*0.19)*12;\n  const w1y = Math.cos(y*0.02-t*0.22)*16+Math.sin(x*0.016+t*0.31)*11;\n  const w2x = Math.sin((x+w1x)*0.025-t*0.4)*8+Math.cos((y+w1y)*0.02+t*0.35)*6;\n  const w2y = Math.cos((y+w1y)*0.022+t*0.38)*7+Math.sin((x+w1x)*0.019-t*0.42)*5;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.55)*110, 80+Math.cos(t*0.38)*55, 0.075, 2.1, 0.0],\n    [320+Math.cos(t*0.48)*105, 160+Math.sin(t*0.65)*55, 0.095, 1.75, 1.2],\n    [240+Math.sin(t*0.28+2)*145, 120+Math.cos(t*0.45+1)*95, 0.058, 2.4, 2.5],\n    [110+Math.cos(t*0.75+1)*85, 185+Math.sin(t*0.58+3)*65, 0.11, 1.55, 3.8],\n    [370+Math.sin(t*0.38+4)*95, 55+Math.cos(t*0.85+2)*75, 0.068, 2.7, 5.1],\n    [240+Math.cos(t*0.32+5)*125, 205+Math.sin(t*0.52)*85, 0.085, 1.95, 0.8],\n    [60+Math.sin(t*0.62+3)*70, 40+Math.cos(t*0.42+4)*50, 0.13, 1.4, 4.2],\n    [420+Math.cos(t*0.56+2)*60, 200+Math.sin(t*0.72+1)*45, 0.1, 2.0, 2.0],\n    [200+Math.sin(t*0.44+6)*100, 220+Math.cos(t*0.33+3)*70, 0.072, 2.3, 5.5]\n  ];\n  let aS=0, iS=0, harm=0;\n  for (const [sX,sY,f,sp,ph] of src) {\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const wA=Math.sin(d*f-t*sp+ph), wI=Math.sin(d*f*0.65+t*sp*0.55+ph+1.8);\n    aS+=wA; iS+=wI; harm+=Math.sin(d*f*0.4-t*sp*0.3+ph*2.1)*0.6;\n  }\n  const n=src.length, act=aS/n, inh=iS/n, hrm=harm/n;\n  const bg=(Math.sin(sx*0.038+sy*0.023+t*0.75)+Math.sin(sx*0.028-sy*0.038+t*1.05))/2\n    +Math.sin((sx+sy)*0.11+t*2.3)*0.22+Math.sin((sx-sy)*0.095-t*1.8)*0.18\n    +Math.sin(sx*0.065+t*1.6)*Math.cos(sy*0.055-t*1.3)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*3.5-t*1.4)+Math.sin(dist*0.035+ang*4.5-t*1.1))*0.35\n    +Math.sin(dist*0.08-ang*2-t*2.5)*0.15;\n  const radial=Math.sin(dist*0.06-t*1.8)*0.2*(1-dist/350);\n  const rd1=Math.tanh((act-inh*0.65+bg*0.28+spiral+radial)*2.0);\n  const rd2=Math.tanh((act*0.8+inh*0.5-bg*0.4+hrm*0.35)*1.6);\n  const rdMix=rd1*0.7+rd2*0.3;\n  const cell=Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14)+Math.sin((sx+sy)*0.095+t)*0.45)*1.4)*0.28;\n  const micro=Math.sin(sx*0.3+t*3)*Math.sin(sy*0.28-t*2.5)*0.08;\n  const blend=rdMix*0.7+cell*0.2+micro, v=blend*0.5+0.5;\n  const pal=[\n    [5,12,55],[10,35,85],[15,70,115],[18,110,130],[25,150,125],\n    [60,175,110],[140,195,80],[200,190,55],[220,160,50],\n    [210,120,60],[185,75,65],[150,45,70],[110,28,65],[65,18,55],[25,12,50],[5,12,55]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const lum=0.78+Math.sin(rdMix*Math.PI)*0.22;\n  const edge=Math.abs(rdMix)>0.65?1.18:Math.abs(rdMix)>0.4?1.08:1.0;\n  const glow=Math.max(0,Math.abs(rdMix)-0.6)*0.8;\n  const vig=1.0-Math.sqrt((x-cx)**2+(y-cy)**2)/420*0.25;\n  return [\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*40)*vig)|0,\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*30)*vig)|0,\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*50)*vig)|0\n  ];\n}",
