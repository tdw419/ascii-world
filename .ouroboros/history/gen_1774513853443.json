  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.013-t*0.22)*12;\n  const w1y = Math.cos(y*0.018-t*0.28)*18 + Math.sin(x*0.016+t*0.33)*12;\n  const w2x = Math.sin(w1x*0.025+y*0.01+t*0.5)*8;\n  const w2y = Math.cos(w1y*0.025+x*0.01-t*0.45)*8;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100+Math.sin(t*1.1)*30, 80+Math.cos(t*0.4)*50+Math.cos(t*0.9)*20, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100+Math.cos(t*1.3)*25, 160+Math.sin(t*0.7)*50+Math.sin(t*1.2)*25, 0.1, 1.7, 0.9],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.1],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.85],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.05],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.95],\n    [80+Math.sin(t*0.7+3)*60, 40+Math.cos(t*0.6+2)*40, 0.14, 1.3, 0.8],\n    [400+Math.cos(t*0.45+1)*70, 200+Math.sin(t*0.8+4)*50, 0.11, 1.8, 1.15]\n  ];\n  let aS=0, iS=0, aS2=0, iS2=0;\n  for (const [sX,sY,f,sp,w] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS += Math.sin(d*f-t*sp)*w;\n    iS += Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;\n    aS2 += Math.sin(d*f*1.618-t*sp*1.3+0.7)*w*0.5;\n    iS2 += Math.sin(d*f*1.1+t*sp*0.8+3.0)*w*0.5;\n  }\n  const act=(aS+aS2)/9, inh=(iS+iS2)/9;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.08+sy*0.06-t*1.5)*0.5+Math.sin(sx*0.12-sy*0.09+t*2.2)*0.25)/2.25;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.07-ang*2+t*0.8)*0.6+Math.sin(dist*0.03+ang*5-t*2.0)*0.4)*0.25;\n  const gx=(sx*0.08)|0, gy=(sy*0.08)|0;\n  const cn=(Math.sin(gx*12.9898+gy*78.233)*43758.5453)%1;\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+cn*0.3)*1.5)*0.3;\n  const rd1=act-inh*0.7, rd2=aS2-iS2*0.6;\n  const reaction=Math.tanh((rd1+rd2*0.4+bg*0.3+spiral)*2.0);\n  const blend=reaction*0.65+cell*0.2+spiral*0.15, v=blend*0.5+0.5;\n  const pal=[[12,8,48],[25,30,95],[30,75,120],[35,135,130],[80,175,130],[180,195,85],[220,170,60],[215,110,55],[185,65,65],[140,40,70],[85,25,65],[12,8,48]];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i, sf=f*f*(3-2*f);\n  const lum=0.85+Math.sin(reaction*Math.PI)*0.15;\n  const edge=Math.abs(reaction)>0.75?1.12:Math.abs(reaction)>0.5?1.05:1.0;\n  const cs=Math.sin(t*0.2)*0.05;\n  return [\n    Math.min(255,Math.max(0,((pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*lum*edge+cs*30))|0),\n    Math.min(255,Math.max(0,((pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*lum*edge+cs*10))|0),\n    Math.min(255,Math.max(0,((pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*lum*edge-cs*20))|0)\n  ];\n}",
