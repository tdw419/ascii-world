  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  const w1y = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  const w2x = Math.sin((x+w1x)*0.035-t*0.5)*8 + Math.cos((y+w1y)*0.025+t*0.4)*6;\n  const w2y = Math.cos((y+w1y)*0.03+t*0.45)*8 + Math.sin((x+w1x)*0.028-t*0.55)*6;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 0.9],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.1],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.8],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.2],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.95],\n    [80+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+1)*50, 0.11, 2.1, 0.85],\n    [400+Math.cos(t*0.55+2)*60, 200+Math.sin(t*0.75+4)*45, 0.05, 2.8, 1.15],\n    [200+Math.sin(t*0.38+6)*110, 100+Math.cos(t*0.48+2)*70, 0.09, 2.0, 1.0],\n    [300+Math.cos(t*0.42+1)*90, 180+Math.sin(t*0.52+5)*60, 0.13, 1.4, 0.75]\n  ];\n  let aS=0,iS=0,aS2=0,iS2=0;\n  for(const[sX,sY,f,sp,w]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp)*w; iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;\n    aS2+=Math.sin(d*f*1.8-t*sp*1.3+0.5)*w*0.6; iS2+=Math.sin(d*f*1.3+t*sp*0.9+2.8)*w*0.6;\n  }\n  const act=aS/8,inh=iS/8,act2=aS2/8,inh2=iS2/8;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1))/2\n    +Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.4;\n  const micro=(Math.sin(sx*0.2+sy*0.15+t*1.5)+Math.sin(sx*0.18-sy*0.22-t*1.8))*0.15;\n  const r1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2);\n  const r2=Math.tanh((act2-inh2*0.6+micro)*2.5);\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5)*1.5)*0.3;\n  const coupled=r1*0.6+r2*0.25+cell*0.15+Math.sin(r1*r2*Math.PI*2)*0.08;\n  const v=coupled*0.5+0.5;\n  const pal=[[5,12,45],[12,45,85],[20,90,120],[30,140,135],[80,175,120],[180,195,80],[220,175,60],[215,130,65],[195,85,70],[160,50,75],[100,30,60],[45,18,48],[5,12,45]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const vig=1.0-Math.sqrt((x-cx)**2+(y-cy)**2)/380*0.15;\n  const lum=(0.8+Math.sin(r1*Math.PI)*0.2)*vig;\n  const edge=Math.abs(r1)>0.65?1.12:Math.abs(r2)>0.6?1.06:1.0;\n  const fine=1.0+Math.sin(sx*0.3+sy*0.25+t*2)*0.03;\n  return[\n    Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge*fine)|0,\n    Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge*fine)|0,\n    Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge*fine)|0\n  ];\n}",
