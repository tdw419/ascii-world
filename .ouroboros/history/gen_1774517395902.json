  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.015+t*0.25)*20+Math.cos(y*0.012-t*0.18)*15;\n  const w1y = Math.cos(y*0.015-t*0.2)*20+Math.sin(x*0.013+t*0.3)*15;\n  const w2x = Math.sin((x+w1x)*0.025+t*0.4)*8+Math.cos((y+w1y)*0.02-t*0.35)*6;\n  const w2y = Math.cos((y+w1y)*0.025-t*0.3)*8+Math.sin((x+w1x)*0.022+t*0.45)*6;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [120+Math.sin(t*0.5)*90,60+Math.cos(t*0.35)*40,0.08,2.0],\n    [360+Math.cos(t*0.45)*90,50+Math.sin(t*0.6)*45,0.09,1.8],\n    [80+Math.cos(t*0.55+1)*70,180+Math.sin(t*0.4+2)*50,0.07,2.2],\n    [400+Math.sin(t*0.5+3)*80,170+Math.cos(t*0.45+1)*55,0.11,1.6],\n    [240+Math.sin(t*0.3+2)*130,100+Math.cos(t*0.5+1)*80,0.06,2.4],\n    [240+Math.cos(t*0.35+5)*110,160+Math.sin(t*0.55)*70,0.085,2.0],\n    [180+Math.sin(t*0.65+4)*60,120+Math.cos(t*0.5+3)*60,0.1,1.5],\n    [300+Math.cos(t*0.4+2)*70,130+Math.sin(t*0.7+1)*50,0.075,2.1],\n    [160+Math.sin(t*0.38)*50,200+Math.cos(t*0.62+2)*40,0.12,1.4],\n    [340+Math.cos(t*0.52+1)*55,90+Math.sin(t*0.48+3)*45,0.065,2.5]\n  ];\n  let act=0,inh=0,act2=0,inh2=0;\n  for(const[sX,sY,f,sp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    act+=Math.sin(d*f-t*sp);inh+=Math.sin(d*f*0.7+t*sp*0.6+1.5);\n    act2+=Math.sin(d*f*2.3-t*sp*1.3+0.8);inh2+=Math.sin(d*f*1.6+t*sp*0.9+2.2);\n  }\n  act/=10;inh/=10;act2/=10;inh2/=10;\n  const bg=(Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.028-sy*0.038+t*1.0))/2+Math.sin((sx+sy)*0.1+t*2.2)*0.15+Math.sin((sx-sy)*0.085-t*1.8)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*3-t*1.3)+Math.sin(dist*0.038+ang*4-t*1.0)+Math.sin(dist*0.06-ang*2+t*0.8)*0.5)*0.35;\n  const pulse=Math.sin(dist*0.08-t*3)*Math.exp(-dist*0.003)*0.3;\n  const rd1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.0);\n  const rd2=Math.tanh((act2-inh2*0.6+bg*0.2-spiral*0.5)*1.8);\n  const cell=Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14)+Math.