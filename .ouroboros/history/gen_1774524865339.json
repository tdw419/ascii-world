  "code": "(x, y, t) => {\n  const wx1 = Math.sin(x*0.018+t*0.25)*18+Math.cos(y*0.013-t*0.18)*12+Math.sin((x+y)*0.008+t*0.4)*8;\n  const wy1 = Math.cos(y*0.02-t*0.22)*18+Math.sin(x*0.015+t*0.3)*12+Math.cos((x-y)*0.01-t*0.35)*8;\n  const sx1 = x+wx1, sy1 = y+wy1;\n  const wx2 = Math.sin(sx1*0.012-t*0.15)*10+Math.cos(sy1*0.009+t*0.12)*8;\n  const wy2 = Math.cos(sy1*0.011+t*0.13)*10+Math.sin(sx1*0.01-t*0.16)*8;\n  const sx = sx1+wx2, sy = sy1+wy2;\n  const src = [\n    [160+Math.sin(t*0.5)*110,80+Math.cos(t*0.35)*55,0.075,2.1],\n    [320+Math.cos(t*0.45)*110,160+Math.sin(t*0.6)*55,0.09,1.8],\n    [240+Math.sin(t*0.28+2)*150,120+Math.cos(t*0.42+1)*95,0.055,2.4],\n    [120+Math.cos(t*0.7+1)*85,180+Math.sin(t*0.5+3)*65,0.11,1.6],\n    [360+Math.sin(t*0.38+4)*95,60+Math.cos(t*0.75+2)*75,0.065,2.7],\n    [240+Math.cos(t*0.32+5)*130,200+Math.sin(t*0.48)*85,0.085,2.0],\n    [80+Math.sin(t*0.55+3)*70,120+Math.cos(t*0.65+4)*60,0.095,1.9],\n    [400+Math.cos(t*0.42+2)*80,200+Math.sin(t*0.38+1)*70,0.07,2.5],\n    [240+Math.sin(t*0.22)*160,40+Math.cos(t*0.33+3)*80,0.048,2.8]\n  ];\n  let aS=0,iS=0,hS=0;\n  for(const[sX,sY,f,sp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp);iS+=Math.sin(d*f*0.7+t*sp*0.55+1.5);hS+=Math.cos(d*f*0.5-t*sp*0.4+3.0);\n  }\n  const n=src.length,act=aS/n,inh=iS/n,harm=hS/n;\n  const bg=(Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.025-sy*0.035+t*0.95)+Math.sin(sx*0.05+sy*0.01-t*1.3)*0.5)/2.5+Math.sin((sx+sy)*0.1+t*2.2)*0.15+Math.sin((sx-sy)*0.08-t*1.8)*0.15;\n  const cx=240,cy=120,dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*4-t*1.3)+Math.sin(dist*0.035+ang*5-t*1.0)+Math.sin(dist*0.06-ang*2+t*0.7)*0.4)*0.3;\n  const pulse=Math.sin(dist*0.08-t*2.5)*Math.exp(-dist*0.003)*0.3;\n  const r1=Math.tanh((act-inh*0.65+bg*0.35+spiral+pulse)*2.0);\n  const r2=Math.tanh((harm+act*0.4-inh*0.5+Math.sin(sx*0.08+sy*0.06-t*1.5)*0.8)*1.8);\n  const cell=Math.tanh((Math.sin(sx*0.12)*Math.sin(sy*0.12)+Math.sin((sx+sy)*0.08+t*0.8)*0.5+Math.sin(sx*0.06-sy*0.09+t*0.5)*0.3)*1.5)*0.25;\n  const blend=r1*0.55+r2*0.2+cell*0.25,v=blend*0.5+0.5;\n  const pal=[[6,12,52],[12,45,85],[18,90,120],[25,140,130],[45,175,120],[120,195,80],[210,200,65],[225,155,55],[210,95,60],[170,50,70],[100,25,55],[45,15,48],[6,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const energy=Math.abs(r1)+Math.abs(r2)*0.5,lum=0.75+Math.sin(energy*Math.PI)*0.25;\n  const edge=energy>0.7?1.2:energy>0.4?1.05:0.95;\n  const glow=Math.max(0,1-dist*0.004)*0.15;\n  return[\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*30)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*40)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*60)|0)\n  ];\n}",
