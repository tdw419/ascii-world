  "code": "(x, y, t) => {\n  const wx = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10 + Math.sin((x+y)*0.03+t*0.5)*8 + Math.cos(x*0.05-y*0.03+t*0.7)*5;\n  const wy = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10 + Math.cos((x-y)*0.025-t*0.45)*8 + Math.sin(y*0.04+x*0.02-t*0.6)*5;\n  const sx = x + wx, sy = y + wy;\n  const sx2 = sx + Math.sin(sy*0.05+t)*6, sy2 = sy + Math.cos(sx*0.04-t*0.8)*6;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 0.8],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.2],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.7],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.1],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.9],\n    [60+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+1)*50, 0.14, 1.3, 0.6],\n    [420+Math.cos(t*0.55+2)*60, 200+Math.sin(t*0.75+4)*50, 0.11, 2.1, 1.3],\n    [200+Math.sin(t*0.25+6)*110, 220+Math.cos(t*0.45+2)*70, 0.075, 1.8, 1.0],\n    [300+Math.cos(t*0.7+3)*80, 30+Math.sin(t*0.5+5)*60, 0.13, 2.4, 0.85]\n  ];\n  let act=0, inh=0, feed=0;\n  for (const [sX,sY,f,sp,amp] of src) {\n    const d = Math.sqrt((sx2-sX)**2+(sy2-sY)**2);\n    act += Math.sin(d*f-t*sp)*amp;\n    inh += Math.sin(d*f*0.7+t*sp*0.6+1.5)*amp;\n    feed += Math.sin(d*f*1.3-t*sp*0.8+3.0)*amp*0.5;\n  }\n  act/=10; inh/=10; feed/=10;\n  const bg = (Math.sin(sx2*0.04+sy2*0.025+t*0.8)+Math.sin(sx2*0.03-sy2*0.04+t*1.1))/2 + Math.sin((sx2+sy2)*0.12+t*2.5)*0.2 + Math.sin((sx2-sy2)*0.1-t*2)*0.2 + Math.sin(sx2*0.07+sy2*0.06-t*1.8)*0.15 + Math.sin(sx2*0.02-sy2*0.08+t*0.9)*0.1;\n  const cx=240, cy=120, dist=Math.sqrt((sx2-cx)**2+(sy2-cy)**2), ang=Math.atan2(sy2-cx, sx2-cy);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.4 + Math.sin(dist*0.08-ang*2-t*2.5)*0.15 + Math.sin(dist*0.03+ang*5-t*0.8)*0.1;\n  const turing = Math.sin(sx2*0.15)*Math.sin(sy2*0.15)+Math.sin(sx2*0.22+sy2*0.18)*0.5+Math.sin(sx2*0.1-sy2*0.13+t*0.3)*0.3;\n  const micro = Math.sin(sx2*0.3+t*3)*Math.sin(sy2*0.3-t*2.5)*0.15+Math.sin((sx2+sy2)*0.2+t*2)*0.1;\n  const rd = Math.tanh((act-inh*0.65+bg*0.25+spiral*0.35+feed*0.2)*2.2);\n  const cell = Math.tanh(turing*1.5)*0.25;\n  const detail = micro*Math.abs(rd);\n  const blend = rd*0.65+cell*0.2+detail*0.15, v = blend*0.5+0.5;\n  const pal = [[5,12,45],[10,45,85],[15,85,115],[20,130,125],[45,165,120],[140,185,85],[210,185,60],[225,150,50],[210,100,55],[165,55,65],[95,30,65],[45,18,55],[15,12,45],[5,12,45]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.75+Math.sin(rd*Math.PI)*0.25;\n  const edge = Math.abs(rd)>0.65?1.2:(Math.abs(rd)>0.4?1.05:0.95);\n  const glow = Math.max(0,1.0-Math.abs(rd)*1.5)*0.15;\n  return [\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*180)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*140)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*100)|0)\n  ];\n}",
