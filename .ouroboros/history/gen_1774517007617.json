  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  let wx = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  let wy = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  wx += Math.sin((x+wx)*0.04-t*0.5)*5 + Math.cos((y+wy)*0.035+t*0.4)*4;\n  wy += Math.cos((y+wy)*0.04+t*0.55)*5 + Math.sin((x+wx)*0.038-t*0.45)*4;\n  const sx = x + wx, sy = y + wy;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9],\n    [80+Math.sin(t*0.45+3)*60, 40+Math.cos(t*0.65+1)*40, 0.14, 2.1],\n    [400+Math.cos(t*0.55+2)*70, 200+Math.sin(t*0.75+4)*50, 0.11, 1.8],\n    [200+Math.sin(t*0.7+5)*50, 220+Math.cos(t*0.3+3)*60, 0.09, 2.4],\n    [300+Math.cos(t*0.42)*80, 30+Math.sin(t*0.58+2)*45, 0.13, 2.0]\n  ];\n  let aS = 0, iS = 0;\n  for (const [sX, sY, f, sp] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    aS += Math.sin(d*f - t*sp);\n    iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5);\n  }\n  const n = src.length, act = aS/n, inh = iS/n;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8) + Math.sin(sx*0.03-sy*0.04+t*1.1) + Math.sin(sx*0.08+sy*0.06-t*1.5)*0.5 + Math.sin(sx*0.12-sy*0.09+t*2.2)*0.25)/2.75 + Math.sin((sx+sy)*0.12+t*2.5)*0.2 + Math.sin((sx-sy)*0.1-t*2)*0.2;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5) + Math.sin(dist*0.04+ang*4-t*1.2) + Math.sin(dist*0.08-ang*2+t*2))*0.3;\n  const rd1 = Math.tanh((act - inh*0.7 + bg*0.3 + spiral)*2.2);\n  const a2 = Math.sin(sx*0.12-t*1.5)*Math.cos(sy*0.1+t*1.2) + Math.sin(dist*0.08+ang*5-t*0.8)*0.5;\n  const i2 = Math.cos(sx*0.09+t*1.3)*Math.sin(sy*0.11-t*1.1) + Math.cos(dist*0.06-ang*3+t*1.2)*0.5;\n  const rd2 = Math.tanh((a2 - i2*0.6 + spiral*0.4)*1.8);\n  const cell = Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15) + Math.sin((sx+sy)*0.1+t)*0.5 + Math.sin(sx*0.2-sy*0.18+t*0.7)*0.3)*1.5)*0.3;\n  const micro = Math.sin(sx*0.3+t*3)*Math.sin(sy*0.28-t*2.5)*0.1;\n  const blend = rd1*0.5 + rd2*0.25 + cell*0.15 + micro*0.1, v = blend*0.5+0.5;\n  const pal = [[6,12,52],[12,45,85],[18,85,120],[25,140,135],[60,175,130],[140,195,90],[210,185,65],[225,140,60],[210,95,65],[175,55,75],[120,30,65],[60,18,55],[6,12,52]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.85+Math.sin(rd1*Math.PI)*0.15, edge = Math.abs(rd1)>0.65?1.2:Math.abs(rd2)>0.7?1.1:1.0;\n  return [\n    Math.min(255, (pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge)|0,\n    Math.min(255, (pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge)|0,\n    Math.min(255, (pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge)|0\n  ];\n}",
