  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.25)*18 + Math.cos(y*0.013-t*0.18)*12 + Math.sin((x+y)*0.008+t*0.4)*8;\n  const w1y = Math.cos(y*0.02-t*0.22)*18 + Math.sin(x*0.015+t*0.3)*12 + Math.cos((x-y)*0.009-t*0.35)*8;\n  const w2x = Math.sin(w1x*0.025+t*0.6)*6 + Math.cos(w1y*0.02-t*0.45)*5;\n  const w2y = Math.cos(w1y*0.022-t*0.5)*6 + Math.sin(w1x*0.018+t*0.55)*5;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.5)*110, 80+Math.cos(t*0.35)*60, 0.075, 2.1, 0],\n    [320+Math.cos(t*0.45)*110, 160+Math.sin(t*0.6)*55, 0.095, 1.8, 1.2],\n    [240+Math.sin(t*0.28+2)*150, 120+Math.cos(t*0.42+1)*100, 0.055, 2.4, 2.5],\n    [100+Math.cos(t*0.7+1)*90, 190+Math.sin(t*0.55+3)*65, 0.11, 1.6, 0.8],\n    [380+Math.sin(t*0.38+4)*95, 55+Math.cos(t*0.75+2)*75, 0.065, 2.7, 1.8],\n    [240+Math.cos(t*0.32+5)*130, 210+Math.sin(t*0.48)*85, 0.085, 2.0, 3.2],\n    [60+Math.sin(t*0.6+3)*70, 40+Math.cos(t*0.5+1)*50, 0.13, 1.4, 2.0],\n    [420+Math.cos(t*0.33+2)*60, 200+Math.sin(t*0.65+4)*55, 0.07, 2.9, 0.5],\n    [200+Math.sin(t*0.55+1)*100, 30+Math.cos(t*0.4+3)*40, 0.088, 2.2, 1.5]\n  ];\n  let aS=0, iS=0, tS=0;\n  for (const [sX,sY,f,sp,ph] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS += Math.sin(d*f-t*sp+ph);\n    iS += Math.sin(d*f*0.65+t*sp*0.55+ph+1.5);\n    tS += Math.sin(d*f*0.4-t*sp*0.3+ph*2+3)*0.5;\n  }\n  const act=aS/9, inh=iS/9, ter=tS/9;\n  const bg = (Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.028-sy*0.035+t*0.95)+Math.sin(sx*0.015+sy*0.04-t*0.6))/3\n    + Math.sin((sx+sy)*0.1+t*2.2)*0.15 + Math.sin((sx-sy)*0.08-t*1.8)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral = (Math.sin(dist*0.045-ang*3.5-t*1.3)+Math.sin(dist*0.035+ang*4.5-t*1.0)+Math.sin(dist*0.06-ang*2-t*1.8)*0.6)/2.6;\n  const micro = Math.sin(sx*0.12+t*1.5)*Math.sin(sy*0.12-t*1.2)*Math.cos((sx-sy)*0.08+t*0.8);\n  const reaction = Math.tanh((act - inh*0.65 + bg*0.25 + spiral*0.35 + ter*0.15 + micro*0.1)*2.0);\n  const cell = Math.tanh((Math.sin(sx*0.13)*Math.sin(sy*0.13)+Math.sin((sx+sy)*0.09+t*0.8)*0.4+Math.sin(sx*0.07-t*0.5)*Math.cos(sy*0.08+t*0.4)*0.3)*1.4)*0.25;\n  const membrane = Math.tanh(Math.abs(reaction)*4-2.5)*0.15;\n  const blend = reaction*0.6+cell*0.2+membrane*0.2, v=blend*0.5+0.5;\n  const pal = [\n    [5,10,45],[10,35,85],[12,65,120],[18,110,140],[25,155,135],\n    [80,175,110],[170,190,70],[220,175,55],[230,130,60],[210,80,65],\n    [170,45,60],[110,25,55],[55,15,50],[20,10,45],[5,10,45]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const sm=f*f*(3-2*f);\n  const lum=0.75+Math.sin(reaction*Math.PI)*0.25;\n  const edge=Math.abs(reaction)>0.65?1.2:Math.abs(reaction)>0.4?1.08:0.95;\n  const glow=Math.max(0, 1-Math.abs(reaction)*1.5)*0.08;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*sm)*lum*edge+glow*60)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*sm)*lum*edge+glow*80)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*sm)*lum*edge+glow*120)|0)\n  ];\n}",
