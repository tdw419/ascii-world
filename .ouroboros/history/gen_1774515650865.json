  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.25)*18+Math.cos(y*0.013-t*0.18)*12;\n  const w1y = Math.cos(y*0.02-t*0.22)*16+Math.sin(x*0.015+t*0.3)*11;\n  const w2x = Math.sin((x+w1x)*0.025-t*0.4)*8+Math.cos((y+w1y)*0.02+t*0.35)*6;\n  const w2y = Math.cos((y+w1y)*0.022+t*0.38)*7+Math.sin((x+w1x)*0.028-t*0.32)*5;\n  const sx=x+w1x+w2x, sy=y+w1y+w2y;\n  const src=[\n    [160+Math.sin(t*0.5)*110,80+Math.cos(t*0.35)*60,0.075,2.1,0.6],\n    [320+Math.cos(t*0.45)*100,160+Math.sin(t*0.6)*55,0.09,1.8,0.4],\n    [240+Math.sin(t*0.28+2)*150,120+Math.cos(t*0.45+1)*100,0.055,2.5,0.7],\n    [100+Math.cos(t*0.7+1)*90,190+Math.sin(t*0.55+3)*70,0.11,1.4,0.5],\n    [370+Math.sin(t*0.38+4)*100,55+Math.cos(t*0.8+2)*80,0.065,2.8,0.3],\n    [240+Math.cos(t*0.32+5)*130,210+Math.sin(t*0.5)*90,0.085,2.0,0.55],\n    [60+Math.sin(t*0.6+3)*70,40+Math.cos(t*0.4+5)*50,0.1,1.6,0.45],\n    [420+Math.cos(t*0.55+2)*60,200+Math.sin(t*0.75+1)*80,0.07,2.3,0.65],\n    [180+Math.sin(t*0.42+6)*80,220+Math.cos(t*0.58+4)*60,0.095,1.9,0.35],\n    [300+Math.cos(t*0.33+3)*110,30+Math.sin(t*0.48+2)*70,0.06,2.6,0.5]\n  ];\n  let aS=0,iS=0,hrm=0;\n  for(const[sX,sY,f,sp,w]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp)*w;\n    iS+=Math.sin(d*f*0.65+t*sp*0.55+1.5)*(1-w);\n    hrm+=Math.sin(d*f*1.3-t*sp*0.8+2)*0.5;\n  }\n  const act=aS/10,inh=iS/10,har=hrm/10;\n  const bg1=(Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.028-sy*0.038+t*0.95))/2;\n  const bg2=(Math.sin(sx*0.05-sy*0.015+t*1.3)+Math.cos(sx*0.018+sy*0.045-t*1.1))/2;\n  const bg3=Math.sin((sx+sy)*0.1+t*2.2)*0.3+Math.sin((sx-sy)*0.08-t*1.8)*0.3;\n  const micro=Math.sin(sx*0.2+sy*0.15+t*3)*Math.cos(sx*0.12-sy*0.18-t*2.5)*0.15;\n  const bg=bg1*0.4+bg2*0.3+bg3+micro;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const sp1=(Math.sin(dist*0.045-ang*3.5-t*1.3)+Math.sin(dist*0.035+ang*4.5-t*1.0))*0.35;\n  const sp2=(Math.sin(dist*0.06+ang*2-t*1.8)+Math.cos(dist*0.04-ang*5+t*0.7))*0.2;\n  const spiral=sp1+sp2;\n  const rd1=Math.tanh((act-inh*0.65+bg*0.25+spiral)*2.0);\n  const rd2=Math.tanh((act*0.8-inh*0.5+har*0.3+bg*0.15-spiral*0.2)*1.8);\n  const feedback=Math.tanh((rd1+rd2*0.6+har*0.2)*1.5);\n  const cell=Math.tanh((Math.sin(sx*0.13)*Math.sin(sy*0.13)+Math.sin((sx+sy)*0.09+t*0.8)*0.4+Math.sin(sx*0.07-t*0.5)*Math.cos(sy*0.11+t*0.3)*0.3)*1.3)*0.25;\n  const edge=Math.max(0,Math.abs(rd1)-0.5)*2;\n  const blend=feedback*0.65+cell*0.2+edge*0.15,v=blend*0.5+0.5;\n  const pal=[[6,12,58],[12,45,95],[18,85,125],[25,130,140],[40,165,130],[120,195,100],[210,195,70],[225,150,65],[195,90,60],[140,50,70],[80,25,65],[40,15,55],[6,12,58]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.85+Math.sin(feedback*Math.PI)*0.15+edge*0.3;\n  const hl=Math.max(0,edge-0.3)*0.4;\n  return[\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum+hl*200)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum+hl*180)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum+hl*120)|0)\n  ];\n}",
