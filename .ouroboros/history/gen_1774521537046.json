  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.013-t*0.22)*12;\n  const w1y = Math.cos(y*0.016-t*0.28)*18 + Math.sin(x*0.015+t*0.32)*12;\n  const w2x = Math.sin((x+w1x)*0.025-t*0.45)*8 + Math.cos((y+w1y)*0.02+t*0.38)*6;\n  const w2y = Math.cos((y+w1y)*0.023+t*0.42)*8 + Math.sin((x+w1x)*0.019-t*0.35)*6;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 0.7],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, -0.5],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 0.3],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, -0.8],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 0.6],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, -0.3],\n    [80+Math.sin(t*0.45+3)*60, 40+Math.cos(t*0.65+2)*40, 0.14, 1.3, 0.9],\n    [400+Math.cos(t*0.55+1)*70, 200+Math.sin(t*0.75+4)*50, 0.055, 2.8, -0.6]\n  ];\n  let aS = 0, iS = 0, harm = 0;\n  for (const [sX, sY, f, sp, ph] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    aS += Math.sin(d*f - t*sp + ph) + Math.sin(d*f*1.618 - t*sp*0.618 + ph*0.5)*0.3;\n    iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5 + ph);\n    harm += Math.cos(d*f*0.5 - t*sp*1.2 + ph*2)*0.5;\n  }\n  aS /= 8; iS /= 8; harm /= 8;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8) + Math.sin(sx*0.03-sy*0.04+t*1.1) + Math.sin(sx*0.05+sy*0.01-t*0.6))/3 + Math.sin((sx+sy)*0.12+t*2.5)*0.2 + Math.sin((sx-sy)*0.1-t*2)*0.2 + Math.sin(sx*0.08+t*1.8)*Math.sin(sy*0.07-t*1.3)*0.15;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5) + Math.sin(dist*0.04+ang*4-t*1.2))*0.4 + Math.sin(dist*0.03-ang*5-t*0.8)*0.2;\n  const cs = [[120,60],[280,100],[400,180],[200,200],[60,150],[350,30],[180,120],[440,100]];\n  let m1 = 999, m2 = 999;\n  for (const [cX, cY] of cs) {\n    const d = Math.sqrt((sx-(cX+Math.sin(t*0.4+cX*0.1)*20))**2 + (sy-(cY+Math.cos(t*0.35+cY*0.1)*20))**2);\n    if (d < m1) { m2 = m1; m1 = d; } else if (d < m2) { m2 = d; }\n  }\n  const voronoi = Math.sin((m2-m1)*0.15)*0.4 + Math.sin(m1*0.08-t)*0.3;\n  const reaction = Math.tanh((aS - iS*0.65 + bg*0.25 + spiral + voronoi + harm*0.2)*2.0);\n  const micro = Math.tanh((Math.sin(sx*0.22+t*2)*Math.sin(sy*0.22-t*1.8) + Math.sin((sx+sy)*0.15+t*3)*0.4)*2)*0.15;\n  const v = (reaction*0.7 + micro*0.3)*0.5 + 0.5;\n  const pal = [[6,12,52],[10,42,88],[12,72,105],[18,110,120],[40,150,130],[140,185,100],[210,195,70],[220,155,60],[210,110,65],[185,70,70],[140,45,75],[85,25,60],[40,15,48],[6,12,52]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), sf = (idx-i)**2*(3-2*(idx-i));\n  const lum = 0.85 + Math.sin(reaction*Math.PI)*0.15;\n  const edge = Math.abs(reaction)>0.65 ? 1.0+(Math.abs(reaction)-0.65)*0.8 : 1.0;\n  const glow = Math.max(0, reaction)*0.3;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*lum*edge + glow*30)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*lum*edge + glow*20)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*lum*edge + glow*40)|0)\n  ];\n}",
