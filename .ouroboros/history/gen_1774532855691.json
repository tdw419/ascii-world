  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  let wx = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  let wy = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  wx += Math.sin((x+wx)*0.012+t*0.15)*8 + Math.cos((y+wy)*0.01-t*0.12)*6;\n  wy += Math.cos((y+wy)*0.013-t*0.18)*8 + Math.sin((x+wx)*0.011+t*0.14)*6;\n  const sx = x+wx, sy = y+wy;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0,0.7],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7,0.6],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3,0.8],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5,0.5],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6,0.75],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9,0.65],\n    [80+Math.sin(t*0.45+3)*70,40+Math.cos(t*0.65+2)*50,0.11,2.1,0.55],\n    [400+Math.cos(t*0.55+1)*60,220+Math.sin(t*0.75+4)*40,0.13,1.8,0.7],\n    [200+Math.sin(t*0.25+6)*110,200+Math.cos(t*0.45+3)*70,0.05,2.4,0.85],\n    [300+Math.cos(t*0.7+2)*80,100+Math.sin(t*0.5+5)*60,0.09,2.0,0.6]\n  ];\n  let aS=0,iS=0,nS=src.length;\n  for(const[sX,sY,f,sp,w]of src){const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);aS+=Math.sin(d*f-t*sp)*w;iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;}\n  const act=aS/nS,inh=iS/nS;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.08+sy*0.06-t*1.5)*0.5+Math.sin(sx*0.06-sy*0.09+t*2)*0.5)/3+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.07-ang*2-t*2))*0.25;\n  const f1x=160+Math.sin(t*0.2)*60,f1y=80+Math.cos(t*0.15)*40,f2x=320+Math.cos(t*0.25)*60,f2y=160+Math.sin(t*0.2)*40;\n  const focal=Math.sin(Math.sqrt((sx-f1x)**2+(sy-f1y)**2)*0.06-t*1.8)*0.5+Math.sin(Math.sqrt((sx-f2x)**2+(sy-f2y)**2)*0.05+t*1.6)*0.5;\n  const reaction=Math.tanh((act-inh*0.7+bg*0.3+spiral*0.4+focal*0.2)*2.2);\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+Math.sin(sx*0.2-t*0.5)*Math.cos(sy*0.18+t*0.3)*0.3)*1.5)*0.3;\n  const turb=Math.sin(sx*0.1+t)*Math.sin(sy*0.1-t*0.7)*Math.sin((sx+sy)*0.05+t*0.4)*0.15;\n  const v=(reaction*0.6+cell*0.2+turb*0.2)*0.5+0.5;\n  const pal=[[5,12,52],[12,45,85],[18,85,120],[25,135,135],[45,175,145],[120,200,120],[200,195,80],[220,155,65],[195,95,55],[160,50,55],[100,25,55],[50,15,60],[5,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.8+Math.sin(reaction*Math.PI)*0.2,edge=Math.abs(reaction)>0.7?1.15:1.0,peak=reaction>0.85?1+(reaction-0.85)*0.5:1,m=lum*edge*peak;\n  return[Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*m)|0,Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*m)|0,Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*m)|0];\n}",
