t2 = Math.sqrt((sx2-cx2)**2 + (sy2-cy2)**2);\n  const ang2 = Math.atan2(sy2-cy2, sx2-cx2);\n  const sp2 = (Math.sin(dist2*0.06-ang2*2.5+t*1.8) + Math.cos(dist2*0.045+ang2*3.5-t))*0.3;\n  const cell = Math.tanh((Math.sin(sx2*0.15)*Math.sin(sy2*0.15) + Math.sin((sx2+sy2)*0.1+t)*0.5)*1.5)*0.3;\n  const cell2 = Math.tanh((Math.cos(sx2*0.12-sy2*0.08+t*0.5)*Math.sin(sx2*0.08+sy2*0.12-t*0.3))*1.2)*0.2;\n  const rd = Math.tanh((act - inh*0.7 + bg*0.3 + sp1 + sp2)*2.2);\n  const blend = rd*0.6 + (cell+cell2)*0.2 + bg*0.2;\n  const v = blend*0.5+0.5;\n  const pal = [[5,10,45],[10,35,80],[15,70,120],[20,120,130],[40,160,120],[120,175,80],[200,175,55],[220,140,60],[200,95,65],[160,60,70],[110,40,75],[60,25,65],[20,15,50],[5,10,45]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const sf = f*f*(3-2*f);\n  const lum = 0.85 + Math.sin(rd*Math.PI)*0.15;\n  const edge = Math.abs(rd)>0.65?1.2:(Math.abs(rd)>0.4?1.05:0.95);\n  const m = lum * edge * (Math.abs(rd)>0.85?1.3:1.0);\n  return [\n    Math.min(255, (pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*m)|0,\n    Math.min(255, (pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*m)|0,\n    Math.min(255, (pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*m)|0\n  ];\n}",
