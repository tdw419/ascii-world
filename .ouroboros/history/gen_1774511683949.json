  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.013-t*0.22)*12;\n  const w1y = Math.cos(y*0.018-t*0.28)*18 + Math.sin(x*0.016+t*0.33)*12;\n  const w2x = Math.sin((x+w1x)*0.009+t*0.15)*25 + Math.cos((y+w1y)*0.011-t*0.12)*18;\n  const w2y = Math.cos((y+w1y)*0.009-t*0.18)*25 + Math.sin((x+w1x)*0.01+t*0.17)*18;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0,0],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7,0.5],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3,1],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5,1.5],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6,2],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9,2.5],\n    [80+Math.sin(t*0.45+3)*110,40+Math.cos(t*0.65+1)*55,0.055,2.8,3],\n    [400+Math.cos(t*0.55+2)*95,220+Math.sin(t*0.75+4)*65,0.085,2.1,3.5],\n    [200+Math.sin(t*0.25+6)*130,100+Math.cos(t*0.45+2)*80,0.065,2.4,4],\n    [300+Math.cos(t*0.7+3)*85,140+Math.sin(t*0.5+5)*75,0.11,1.6,4.5]\n  ];\n  let aS=0,iS=0,crs=0;\n  for(const[sX,sY,f,sp,ph]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp+ph);\n    iS+=Math.sin(d*f*0.7+t*sp*0.6+ph+1.5);\n    crs+=Math.sin(d*f*1.3-t*sp*0.4+ph*0.5)*Math.cos(d*f*0.5+t*sp*0.3);\n  }\n  const act=aS/10,inh=iS/10,cr=crs/10;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1))/2+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2+Math.sin(sx*0.06+sy*0.08-t*1.5)*0.15+Math.sin(Math.sqrt(sx*sx+sy*sy)*0.03+t*0.6)*0.25;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.4+Math.sin(dist*0.03-ang*5+t*0.8)*0.2+Math.sin(dist*0.07+ang*2-t*2.1)*0.15;\n  const rd1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2);\n  const rd2=Math.tanh((cr-act*0.5+inh*0.4-bg*0.2)*1.8);\n  const rd3=Math.tanh((rd1+rd2+Math.sin(dist*0.08-ang*6-t*1.8)*0.3)*1.5);\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+Math.sin(sx*0.2-sy*0.1+t*0.7)*0.3)*1.5)*0.3;\n  const fine=Math.sin(sx*0.3+t*3)*Math.sin(sy*0.3-t*2.5)*0.1;\n  const blend=rd3*0.5+rd1*0.2+rd2*0.1+cell*0.15+fine*0.05;\n  const v=blend*0.5+0.5;\n  const pal=[[5,12,48],[12,45,82],[18,85,115],[25,135,125],[45,170,130],[120,190,110],[200,195,75],[225,160,55],[215,110,55],[195,70,65],[160,45,75],[110,30,70],[65,20,60],[30,15,52],[5,12,48]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.8+Math.sin(rd3*Math.PI)*0.2;\n  const edge=Math.abs(rd3)>0.65?1.12:Math.abs(rd1)>0.8?1.08:1.0;\n  const glow=Math.max(0,rd3*0.5+rd1*0.3)*0.15;\n  return[\n    Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*60)|0,\n    Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*40)|0,\n    Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*30)|0\n  ];\n}",
