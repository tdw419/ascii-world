  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.012-t*0.2)*12;\n  const w1y = Math.cos(y*0.016-t*0.25)*18 + Math.sin(x*0.014+t*0.35)*12;\n  const w2x = Math.sin((x+w1x)*0.009-t*0.15)*25 + Math.cos((y+w1y)*0.007+t*0.1)*20;\n  const w2y = Math.cos((y+w1y)*0.008+t*0.12)*25 + Math.sin((x+w1x)*0.01-t*0.18)*20;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 0.9],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.1],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.85],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.05],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.95],\n    [80+Math.sin(t*0.45+3)*70, 120+Math.cos(t*0.65+2)*55, 0.11, 2.1, 0.88],\n    [400+Math.cos(t*0.55+1)*60, 200+Math.sin(t*0.75+4)*45, 0.065, 2.4, 1.12],\n    [200+Math.sin(t*0.25+6)*110, 30+Math.cos(t*0.45+3)*40, 0.095, 1.8, 0.92],\n    [300+Math.cos(t*0.7+2)*85, 220+Math.sin(t*0.5+5)*35, 0.075, 2.2, 1.08]\n  ];\n  let aS=0, iS=0, cS=0, dS=0;\n  for (const [sX,sY,f,sp,w] of src) {\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const att = w/(1+d*0.005);\n    aS += Math.sin(d*f-t*sp)*att;\n    iS += Math.sin(d*f*0.7+t*sp*0.6+1.5)*att;\n    cS += Math.cos(d*f*0.5-t*sp*0.4+3.0)*att*0.5;\n    dS += Math.sin(d*f*1.3+t*sp*0.3-2.0)*att*0.4;\n  }\n  const n=10, act=aS/n, inh=iS/n, crs=cS/n, dif=dS/n;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1))/2\n    +Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.4\n    +Math.sin(dist*0.03+ang*6-t*0.8)*0.15;\n  const micro=Math.sin(sx*0.3+t*1.5)*Math.sin(sy*0.3-t*1.2)*0.08\n    +Math.sin(sx*0.22-sy*0.22+t*0.9)*0.06;\n  const reaction=Math.tanh((act-inh*0.65+bg*0.25+spiral+crs*0.3+dif*0.2+micro)*2.0);\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5\n    +Math.sin(sx*0.08-t*0.7)*Math.cos(sy*0.09+t*0.6)*0.3)*1.5)*0.3;\n  const blend=reaction*0.7+cell*0.3, v=blend*0.5+0.5;\n  const pal=[\n    [6,12,52],[10,35,85],[12,65,105],[18,110,125],[28,155,140],\n    [65,180,120],[145,195,80],[210,195,60],[235,165,55],[240,120,60],\n    [225,75,65],[185,45,75],[130,25,65],[75,15,55],[30,10,48],[6,12,52]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const lum=0.78+Math.sin(reaction*Math.PI)*0.22;\n  const edge=Math.abs(reaction)>0.65?1.12+Math.abs(reaction)*0.06:1.0;\n  const glow=Math.max(0,reaction)*0.15;\n  return [\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*80)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*40)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*20)|0)\n  ];\n}",
