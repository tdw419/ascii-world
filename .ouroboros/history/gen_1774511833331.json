  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.28)*18 + Math.cos(y*0.013-t*0.19)*12;\n  const w1y = Math.cos(y*0.017-t*0.23)*16 + Math.sin(x*0.016+t*0.31)*11;\n  const w2x = Math.sin((x+w1x)*0.025-t*0.4)*8 + Math.cos((y+w1y)*0.02+t*0.35)*6;\n  const w2y = Math.cos((y+w1y)*0.022+t*0.38)*9 + Math.sin((x+w1x)*0.019-t*0.42)*7;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [140+Math.sin(t*0.55)*110, 70+Math.cos(t*0.38)*55, 0.085, 2.1, 1.0],\n    [340+Math.cos(t*0.48)*100, 150+Math.sin(t*0.65)*60, 0.095, 1.8, 0.9],\n    [240+Math.sin(t*0.32+2)*130, 110+Math.cos(t*0.52+1)*80, 0.065, 2.4, 1.1],\n    [100+Math.cos(t*0.75+1)*90, 190+Math.sin(t*0.58+3)*65, 0.11, 1.6, 0.85],\n    [380+Math.sin(t*0.42+4)*85, 55+Math.cos(t*0.85+2)*75, 0.075, 2.7, 1.05],\n    [240+Math.cos(t*0.33+5)*110, 210+Math.sin(t*0.5)*70, 0.088, 2.0, 0.95],\n    [60+Math.sin(t*0.6+3)*70, 130+Math.cos(t*0.7+4)*50, 0.1, 1.9, 0.8],\n    [420+Math.cos(t*0.45+2)*60, 100+Math.sin(t*0.55+1)*80, 0.07, 2.5, 1.15]\n  ];\n  let aS=0, iS=0, iS2=0;\n  for (const [sX,sY,f,sp,w] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    aS += Math.sin(d*f - t*sp) * w;\n    iS += Math.sin(d*f*0.7 + t*sp*0.55 + 1.5) * w;\n    iS2 += Math.sin(d*f*1.3 - t*sp*0.8 + 3.0) * w * 0.4;\n  }\n  const a=aS/8, i=iS/8, i2=iS2/8;\n  const bg = (Math.sin(sx*0.038+sy*0.023+t*0.75)+Math.sin(sx*0.028-sy*0.038+t*1.05))/2\n    + Math.sin((sx+sy)*0.11+t*2.3)*0.2 + Math.sin((sx-sy)*0.095-t*1.9)*0.18;\n  const dist = Math.sqrt((sx-cx)**2+(sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.048-ang*3.5-t*1.4)+Math.sin(dist*0.038+ang*4.5-t*1.1))*0.35;\n  const spiral2 = Math.sin(dist*0.07+ang*2-t*2.5)*0.15;\n  const micro = (Math.sin(sx*0.22+t*1.5)*Math.sin(sy*0.22-t*1.2)+Math.sin((sx+sy)*0.16+t*0.8)*0.4)*0.2;\n  const reaction1 = Math.tanh((a - i*0.65 - i2*0.2 + bg*0.25 + spiral + spiral2)*2.0);\n  const reaction2 = Math.tanh((a*0.8 + i*0.3 - i2*0.5 + bg*0.4 - spiral*0.5)*1.8);\n  const cell = Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14)+Math.sin((sx+sy)*0.095+t)*0.45)*1.4)*0.28;\n  const blend = reaction1*0.5 + reaction2*0.2 + cell*0.15 + micro*0.15;\n  const v = blend*0.5+0.5;\n  const pal = [\n    [6,12,52],[12,48,88],[18,95,125],[28,155,148],[65,185,155],\n    [180,195,85],[215,165,60],[210,115,65],[175,58,72],[120,30,68],\n    [65,18,58],[6,12,52]\n  ];\n  const idx = v*(pal.length-1), i0 = Math.min(idx|0, pal.length-2), f = idx-i0;\n  const lum = 0.82 + Math.sin(reaction1*Math.PI)*0.18;\n  const edge = Math.abs(reaction1)>0.65 ? 1.12 + Math.abs(reaction2)*0.08 : 0.92+reaction2*0.08;\n  const vig = 1.0 - (dist/280)**2 * 0.15;\n  const m = lum * edge * vig;\n  return [\n    Math.min(255, (pal[i0][0]+(pal[i0+1][0]-pal[i0][0])*f)*m)|0,\n    Math.min(255, (pal[i0][1]+(pal[i0+1][1]-pal[i0][1])*f)*m)|0,\n    Math.min(255, (pal[i0][2]+(pal[i0+1][2]-pal[i0][2])*f)*m)|0\n  ];\n}",
