  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  let wx = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.013-t*0.22)*12 + Math.sin((x+y)*0.008+t*0.15)*8;\n  let wy = Math.cos(y*0.02-t*0.28)*18 + Math.sin(x*0.016+t*0.33)*12 + Math.cos((x-y)*0.009-t*0.18)*8;\n  let sx = x+wx, sy = y+wy;\n  wx = Math.sin(sy*0.025+t*0.5)*6 + Math.cos(sx*0.02-t*0.4)*5;\n  wy = Math.cos(sx*0.022-t*0.45)*6 + Math.sin(sy*0.018+t*0.55)*5;\n  sx += wx; sy += wy;\n  const src = [\n    [160+Math.sin(t*0.6)*110, 80+Math.cos(t*0.4)*55, 0.075, 2.1],\n    [320+Math.cos(t*0.5)*110, 160+Math.sin(t*0.7)*55, 0.095, 1.8],\n    [240+Math.sin(t*0.3+2)*150, 120+Math.cos(t*0.5+1)*95, 0.055, 2.4],\n    [120+Math.cos(t*0.8+1)*90, 180+Math.sin(t*0.6+3)*65, 0.11, 1.6],\n    [360+Math.sin(t*0.4+4)*100, 60+Math.cos(t*0.9+2)*75, 0.065, 2.7],\n    [240+Math.cos(t*0.35+5)*130, 200+Math.sin(t*0.55)*85, 0.085, 2.0],\n    [80+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+4)*50, 0.1, 1.9],\n    [400+Math.cos(t*0.55+2)*80, 200+Math.sin(t*0.75+1)*60, 0.07, 2.2],\n    [200+Math.sin(t*0.38+6)*100, 220+Math.cos(t*0.48+3)*70, 0.088, 2.5]\n  ];\n  let aS=0, iS=0, iS2=0;\n  for(const [sX,sY,f,sp] of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const df=d*f;\n    aS+=Math.sin(df-t*sp);\n    iS+=Math.sin(df*0.7+t*sp*0.6+1.5);\n    iS2+=Math.sin(df*1.3-t*sp*0.4+3.0)*0.5;\n  }\n  const act=aS/9, inh=iS/9, inh2=iS2/9;\n  const bg=(Math.sin(sx*0.035+sy*0.022+t*0.9)+Math.sin(sx*0.028-sy*0.038+t*1.2))/2\n    +Math.sin((sx+sy)*0.11+t*2.8)*0.2+Math.sin((sx-sy)*0.095-t*2.2)*0.2\n    +Math.sin(sx*0.06+sy*0.04-t*0.7)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const sp1=Math.sin(dist*0.045-ang*3.5-t*1.6), sp2=Math.sin(dist*0.035+ang*4.5-t*1.3);\n  const spiral=(sp1+sp2)*0.35+Math.sin(dist*0.08-ang*2-t*2.5)*0.15;\n  const moire=Math.sin(dist*0.12)*Math.sin(ang*6-t*0.8)*0.2;\n  const pulse=1+Math.sin(t*0.4)*0.15;\n  const rd1=Math.tanh((act-inh*0.65+bg*0.3+spiral)*2.3*pulse);\n  const rd2=Math.tanh((act*0.8-inh2*0.5-bg*0.2+moire)*1.8*pulse);\n  const cell=Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14)+Math.sin((sx+sy)*0.095+t)*0.5+Math.sin(sx*0.08-sy*0.12+t*0.7)*0.3)*1.6)*0.25;\n  const blend=rd1*0.55+rd2*0.2+cell*0.25, v=blend*0.5+0.5;\n  const pal=[\n    [5,12,45],[10,45,85],[15,90,120],[25,145,140],[60,175,135],\n    [160,195,90],[220,185,60],[235,140,55],[225,90,65],[180,50,60],\n    [120,30,55],[60,18,48],[5,12,45]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const lum=0.78+Math.sin(rd1*Math.PI)*0.22;\n  const edge=Math.abs(rd1)>0.65?1.18:Math.abs(rd2)>0.6?1.08:1.0;\n  const glow=Math.max(0,1-Math.abs(rd1)*2)*0.12;\n  return [\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*40))|0,\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*60))|0,\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*80))|0\n  ];\n}",
