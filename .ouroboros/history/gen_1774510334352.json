  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.25)*18 + Math.cos(y*0.013-t*0.18)*12;\n  const w1y = Math.cos(y*0.02-t*0.22)*18 + Math.sin(x*0.016+t*0.28)*12;\n  const w2x = Math.sin((x+y)*0.008+t*0.15)*25;\n  const w2y = Math.cos((x-y)*0.009-t*0.12)*25;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [120+Math.sin(t*0.5)*110, 60+Math.cos(t*0.35)*40, 0.07, 2.1, 1.0],\n    [360+Math.cos(t*0.45)*110, 60+Math.sin(t*0.55)*40, 0.07, 2.1, 0.9],\n    [240+Math.sin(t*0.3+2)*130, 30+Math.cos(t*0.4)*25, 0.055, 2.5, 0.8],\n    [160+Math.cos(t*0.6)*90, 120+Math.sin(t*0.5)*60, 0.085, 1.8, 1.1],\n    [320+Math.sin(t*0.55)*90, 120+Math.cos(t*0.65)*60, 0.085, 1.8, 1.05],\n    [240+Math.cos(t*0.35+1)*140, 120+Math.sin(t*0.45+2)*80, 0.06, 2.4, 1.2],\n    [80+Math.sin(t*0.7+3)*70, 180+Math.cos(t*0.5+1)*50, 0.1, 1.5, 0.85],\n    [400+Math.cos(t*0.4+4)*70, 180+Math.sin(t*0.6+2)*50, 0.1, 1.5, 0.9],\n    [240+Math.sin(t*0.25+5)*100, 210+Math.cos(t*0.38)*40, 0.065, 2.2, 0.95],\n    [60+Math.cos(t*0.8)*60, 40+Math.sin(t*0.7)*30, 0.11, 1.4, 0.7],\n    [420+Math.sin(t*0.75)*60, 220+Math.cos(t*0.85)*30, 0.11, 1.4, 0.7]\n  ];\n  let aS=0, iS=0, cS=0;\n  for (const [sX,sY,f,sp,w] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const fade = 1/(1+d*0.003);\n    aS += Math.sin(d*f - t*sp)*w*fade;\n    iS += Math.sin(d*f*0.618 + t*sp*0.618 + 1.5)*w*fade;\n    cS += Math.cos(d*f*1.414 - t*sp*0.8 + 0.7)*w*fade*0.3;\n  }\n  const n = src.length;\n  const act = aS/n, inh = iS/n, cross = cS/n;\n  const bg1 = (Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.028-sy*0.038+t*0.95))/2;\n  const bg2 = Math.sin((sx+sy)*0.1+t*2.2)*0.15 + Math.sin((sx-sy)*0.09-t*1.8)*0.15;\n  const dist = Math.sqrt((sx-cx)**2+(sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const sp1 = Math.sin(dist*0.045-ang*4-t*1.3);\n  const sp2 = Math.sin(dist*0.038+ang*5-t*1.0);\n  const spiral = (sp1+sp2)*0.3;\n  const rib = Math.sin(ang*6+dist*0.06-t*0.8)*Math.exp(-dist*0.004)*0.4;\n  const rd1 = Math.tanh((act - inh*0.65 + cross*0.4 + bg1*0.25 + bg2 + spiral + rib)*2.0);\n  const micro = Math.sin(sx*0.18+t*0.5)*Math.sin(sy*0.18-t*0.4) + Math.sin((sx+sy)*0.12+t*1.2)*0.5;\n  const rd2 = Math.tanh((rd1*1.5 + micro*0.3)*1.3);\n  const pulse = 0.85 + Math.sin(t*0.8)*0.15;\n  const v = Math.tanh(rd2*pulse)*0.5+0.5;\n  const pal = [\n    [5,10,42],[10,35,82],[12,68,108],[18,115,125],\n    [45,158,135],[110,185,120],[185,200,85],\n    [220,175,60],[225,135,55],[205,85,60],\n    [165,48,55],[100,22,52],[45,12,40],[5,10,42]\n  ];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.75+Math.sin(Math.abs(rd2)*Math.PI)*0.25;\n  const edge = Math.abs(rd2)>0.6 ? 1.12 : Math.abs(rd2)>0.3 ? 1.05 : 0.92;\n  const depth = 1.0 + spiral*0.08;\n  const m = lum*edge*depth;\n  return [\n    Math.min(255, (pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*m)|0,\n    Math.min(255, (pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*m)|0,\n    Math.min(255, (pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*m)|0\n  ];\n}",
