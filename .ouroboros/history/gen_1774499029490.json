  "code": "(x, y, t) => {\n  const wx1 = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  const wy1 = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  const wx2 = Math.sin((x+wx1)*0.015+t*0.5)*8 + Math.cos((y+wy1)*0.012-t*0.4)*6;\n  const wy2 = Math.cos((y+wy1)*0.015-t*0.45)*8 + Math.sin((x+wx1)*0.013+t*0.55)*6;\n  const sx = x+wx1+wx2, sy = y+wy1+wy2;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0,0.8],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7,1.0],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3,0.6],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5,1.2],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6,0.7],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9,0.9],\n    [80+Math.sin(t*0.45+3)*70,40+Math.cos(t*0.65+4)*50,0.11,2.1,0.85],\n    [400+Math.cos(t*0.55+2)*60,200+Math.sin(t*0.75+1)*40,0.13,1.8,1.1],\n    [200+Math.sin(t*0.7+1)*110,220+Math.cos(t*0.3+3)*60,0.05,2.4,0.75]\n  ];\n  let aS=0,iS=0,dif=0,wS=0;\n  for(const[sX,sY,f,sp,w]of src){const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);aS+=Math.sin(d*f-t*sp)*w;iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;dif+=Math.sin(d*f*1.3-t*sp*0.8+2)*w*0.5;wS+=w;}\n  const act=aS/wS,inh=iS/wS,df=dif/wS;\n  const bg1=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1))/2;\n  const bg2=(Math.sin(sx*0.08+sy*0.06-t*1.5)+Math.sin(sx*0.07-sy*0.09+t*1.8))/2;\n  const bg3=Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2;\n  const bg=bg1+bg2*0.5+bg3;\n  const cx=240,cy=120,dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const sp1=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.4;\n  const cx2=240+Math.sin(t*0.3)*100,cy2=120+Math.cos(t*0.4)*60;\n  const d2=Math.sqrt((sx-cx2)**2+(sy-cy2)**2),a2=Math.atan2(sy-cy2,sx-cx2);\n  const sp2=(Math.sin(d2*0.06-a2*2-t*1.8)+Math.sin(d2*0.045+a2*5-t))*0.3;\n  const rx=Math.tanh((act-inh*0.7+bg*0.3+sp1+sp