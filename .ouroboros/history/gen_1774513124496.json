  "code": "(x, y, t) => {\n  const w1 = Math.sin(x*0.012+t*0.4)*Math.cos(y*0.015-t*0.3)*20;\n  const w2 = Math.cos(x*0.018-t*0.25)*Math.sin(y*0.01+t*0.35)*15;\n  const w3 = Math.sin((x+y)*0.008+t*0.15)*12;\n  const sx = x + w1 + w3, sy = y + w2 + w3*0.7;\n  const src = [\n    [160+Math.sin(t*0.5)*100, 80+Math.cos(t*0.35)*50, 0.08, 2.0, 0],\n    [320+Math.cos(t*0.45)*100, 160+Math.sin(t*0.6)*50, 0.1, 1.7, 1],\n    [240+Math.sin(t*0.28+2)*140, 120+Math.cos(t*0.42+1)*90, 0.06, 2.3, 0.5],\n    [120+Math.cos(t*0.7+1)*80, 180+Math.sin(t*0.55+3)*60, 0.12, 1.5, 2],\n    [360+Math.sin(t*0.38+4)*90, 60+Math.cos(t*0.8+2)*70, 0.07, 2.6, 1.5],\n    [240+Math.cos(t*0.32+5)*120, 200+Math.sin(t*0.5)*80, 0.09, 1.9, 3],\n    [80+Math.sin(t*0.6+3)*70, 40+Math.cos(t*0.7+1)*40, 0.11, 2.1, 2.5],\n    [400+Math.cos(t*0.4+2)*60, 220+Math.sin(t*0.65+4)*30, 0.085, 1.8, 0.8]\n  ];\n  let aS = 0, iS = 0;\n  for (const [sX, sY, f, sp, ph] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    aS += Math.sin(d*f - t*sp + ph);\n    iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5 + ph);\n  }\n  const act = aS/8, inh = iS/8;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.06+sy*0.02-t*0.5)*0.5+Math.sin(sx*0.02+sy*0.07+t*0.9)*0.5)/3+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2;\n  const cx = 240, cy = 120;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.08-ang*2-t*2)*0.5)*0.35;\n  const raw = act - inh*0.7 + bg*0.3 + spiral;\n  const rd1 = Math.tanh(raw*2.2);\n  const rd2 = Math.tanh((rd1 + Math.sin(sx*0.08+sy*0.08+t*0.5)*0.3)*2.5);\n  const rd3 = Math.tanh((rd2*0.8 + Math.sin(sx*0.2-t)*Math.sin(sy*0.2+t*0.7)*0.4)*2.0);\n  const cell = Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5)*1.5)*0.3;\n  const blend = rd3*0.6 + cell*0.2 + rd2*0.2;\n  const v = blend*0.5+0.5;\n  const vig = 1.0 - Math.sqrt((x-240)**2+(y-120)**2)/320*0.25;\n  const pal = [[5,12,52],[10,45,85],[15,90,110],[25,150,130],[80,200,150],[180,210,100],[220,180,60],[210,120,80],[180,70,90],[120,40,100],[60,20,75],[5,12,52]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.85+Math.sin(rd3*Math.PI)*0.15;\n  const edge = Math.abs(rd3)>0.65?1.2:(Math.abs(rd3)>0.4?1.05:1.0);\n  const hl = Math.max(0, rd3-0.5)*0.3;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge*vig+hl*60)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge*vig+hl*80)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge*vig+hl*40)|0)\n  ];\n}",
