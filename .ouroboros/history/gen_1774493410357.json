.08;\n  const reaction=Math.tanh((coupled+bg*0.25+spiral+cell+micro)*2.0);\n  const v=reaction*0.5+0.5;\n  const pal=[[5,12,55],[10,45,95],[15,85,130],[20,140,150],[40,180,140],[160,200,80],[220,190,50],[230,140,60],[200,80,60],[150,40,80],[90,25,100],[50,20,80],[15,15,60],[5,12,55]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=(1-Math.cos((idx-i)*Math.PI))*0.5;\n  const lum=0.82+Math.sin(reaction*Math.PI)*0.18;\n  const glow=Math.max(0,Math.abs(reaction)-0.65)*2.5;\n  const bright=(1+glow*0.2)*lum;\n  return[Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*bright)|0,Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*bright)|0,Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*bright)|0];\n}",
