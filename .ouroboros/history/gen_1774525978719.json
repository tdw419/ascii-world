  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const n1 = (px, py) => (Math.sin(px*1.2+py*0.7)*Math.sin(py*1.3-px*0.5)+Math.sin(px*0.8-py*1.1)*Math.cos(px*0.6+py*0.9))*0.5;\n  const w1 = n1(x*0.015+t*0.2, y*0.015-t*0.15), w2 = n1(x*0.02-t*0.18, y*0.02+t*0.22);\n  const wx = w1*25 + Math.sin(y*0.012-t*0.3)*12 + Math.cos(x*0.008+y*0.01+t*0.15)*8;\n  const wy = w2*25 + Math.cos(x*0.012+t*0.25)*12 + Math.sin(y*0.009-x*0.011-t*0.2)*8;\n  const sx = x + wx, sy = y + wy;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 0.85],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.1],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.9],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.05],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.95],\n    [80+Math.sin(t*0.45+3)*110, 40+Math.cos(t*0.65)*55, 0.11, 2.1, 0.8],\n    [400+Math.cos(t*0.55+2)*70, 200+Math.sin(t*0.75+1)*50, 0.065, 2.4, 1.15]\n  ];\n  let aS = 0, iS = 0, aS2 = 0, iS2 = 0;\n  for (const [sX, sY, f, sp, amp] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    const w = Math.sin(d*f - t*sp) * amp;\n    const w2 = Math.sin(d*f*1.5 + t*sp*0.8 + 2.0) * amp * 0.6;\n    aS += w; iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5) * amp;\n    aS2 += w2; iS2 += Math.cos(d*f*0.9 - t*sp*0.5 + 0.8) * amp * 0.5;\n  }\n  const act = (aS+aS2)/14, inh = (iS+iS2)/14;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8) + Math.sin(sx*0.03-sy*0.04+t*1.1))/2\n    + Math.sin((sx+sy)*0.12+t*2.5)*0.2 + Math.sin((sx-sy)*0.1-t*2)*0.2\n    + n1(sx*0.02+t*0.4, sy*0.02-t*0.3)*0.3;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5) + Math.sin(dist*0.04+ang*4-t*1.2))*0.4\n    + Math.sin(dist*0.08-ang*6+t*0.8)*0.15;\n  const reaction = Math.tanh((act - inh*0.7 + bg*0.3 + spiral)*2.2);\n  const cell = Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15) + Math.sin((sx+sy)*0.1+t)*0.5\n    + n1(sx*0.08, sy*0.08)*0.4)*1.5)*0.3;\n  const micro = Math.sin(sx*0.3+sy*0.2-t*3)*Math.sin(sx*0.2-sy*0.3+t*2.5)*0.1;\n  const blend = reaction*0.6 + cell*0.25 + micro*0.15;\n  const v = blend*0.5+0.5;\n  const pal = [\n    [5,12,52],[12,42,88],[18,78,118],[28,128,128],\n    [65,165,115],[140,190,85],[200,185,60],[225,150,55],\n    [215,105,60],[185,65,65],[140,40,70],[85,22,58],\n    [40,15,48],[12,10,42],[5,12,52]\n  ];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.82 + Math.sin(reaction*Math.PI)*0.18;\n  const edge = Math.abs(reaction)>0.72 ? 1.12 + (Math.abs(reaction)-0.72)*0.5 : 1.0;\n  const glow = Math.max(0, 1.0 - Math.abs(reaction)*1.2)*0.15;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge + glow*40)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge + glow*60)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge + glow*80)|0)\n  ];\n}",
