  "code": "(x, y, t) => {\n  const warp = (ax, ay, tt) => [\n    Math.sin(ax*0.018+tt*0.4)*22 + Math.cos(ay*0.022-tt*0.3)*18 + Math.sin((ax+ay)*0.012+tt*0.6)*12,\n    Math.cos(ay*0.02-tt*0.35)*20 + Math.sin(ax*0.016+tt*0.45)*16 + Math.cos((ax-ay)*0.014-tt*0.5)*10\n  ];\n  const [w1x,w1y] = warp(x,y,t);\n  const [w2x,w2y] = warp(x+w1x*0.8,y+w1y*0.8,t*0.7+3);\n  const [w3x,w3y] = warp(x+w2x*0.6+w1x*0.3,y+w2y*0.6+w1y*0.3,t*0.5+7);\n  const sx = x+w1x+w2x*0.5+w3x*0.25, sy = y+w1y+w2y*0.5+w3y*0.25;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0,0.5],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7,0.6],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3,0.4],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5,0.7],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6,0.35],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9,0.55],\n    [80+Math.sin(t*0.45+3)*70,40+Math.cos(t*0.65+1)*55,0.11,2.1,0.45],\n    [400+Math.cos(t*0.55+2)*85,200+Math.sin(t*0.75+4)*65,0.065,2.4,0.5]\n  ];\n  let aS=0,iS=0,mS=0,tw=0;\n  for(const[sX,sY,f,sp,w]of src){const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);aS+=Math.sin(d*f-t*sp)*w;iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;mS+=Math.sin(d*f*1.3-t*sp*0.8+3)*w*0.5;tw+=w;}\n  aS/=tw;iS/=tw;mS/=(tw*0.5);\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.08+sy*0.06-t*1.3)*0.5+Math.sin(sx*0.06-sy*0.09+t*1.6)*0.4)/2.4+Math.sin((sx+sy)*0.12+t*2.5)*0.15+Math.sin((sx-sy)*0.1-t*2)*0.15;\n  const cx=240,cy=120,dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.08-ang*2+t*0.9)*0.4)*0.3;\n  const detail=Math.sin(sx*0.15+t*0.5)*Math.sin(sy*0.15-t*0.3)*0.3+Math.sin(sx*0.3+sy*0.2+t*1.2)*0.15+Math.sin(sx*0.5-sy*0.4-t*1.8)*0.08;\n  const r1=Math.tanh((aS-iS*0.7+bg*0.3+spiral+detail*0.2)*2.2);\n  const r2=Math.tanh((mS-aS*0.5+iS*0.4+spiral*0.8-detail*0.3)*1.8);\n  const rd=r1*0.6+r2*0.4;\n  const lap=Math.abs(rd-Math.tanh((aS*0.9-iS*0.65+bg*0.35+spiral*1.05+detail*0.25)*2.2));\n  const mem=Math.min(1,lap*8);\n  const v=rd*0.5+0.5+mem*0.04*(0.5+0.5*Math.sin(t*2));\n  const vf=Math.max(0,Math.min(1,v));\n  const pal=[[5,12,45],[12,45,85],[18,85,120],[25,140,135],[65,175,140],[160,195,95],[220,185,60],[235,140,55],[210,90,65],[150,50,70],[75,25,55],[5,12,45]];\n  const idx=vf*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.85+Math.sin(rd*Math.PI)*0.15,eb=mem>0.3?1+mem*0.2:1,b=lum*eb;\n  return[Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*b)|0,Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*b)|0,Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*b)|0];\n}",
