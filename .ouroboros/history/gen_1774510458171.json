s)*2.0);\n  const cell=Math.tanh((Math.sin(sx*0.13)*Math.sin(sy*0.13)+Math.sin((sx+sy)*0.09+t)*0.4\n    +Math.sin(sx*0.07-t*0.5)*Math.cos(sy*0.08+t*0.3)*0.3)*1.4)*0.25;\n  const micro=Math.sin(sx*0.25+t*3)*Math.sin(sy*0.25-t*2.5)*0.08*Math.max(0,reaction);\n  const blend=reaction*0.7+cell*0.2+micro, v=blend*0.5+0.5;\n  const pal=[\n    [6,12,52],[12,45,95],[18,85,125],[25,135,135],[140,175,120],\n    [220,195,65],[215,130,60],[185,65,55],[120,28,65],[55,15,55],[6,12,52]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const lum=0.82+Math.sin(reaction*Math.PI)*0.18;\n  const edge=Math.abs(reaction)>0.65?1.12:1.0;\n  const glow=Math.max(0,reaction-0.5)*0.3;\n  return[\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*60)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*40)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*25)|0)\n  ];\n}",
