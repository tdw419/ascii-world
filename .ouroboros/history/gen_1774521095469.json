  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1 = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.013-t*0.22)*12;\n  const w2 = Math.cos(x*0.012-t*0.15)*10 + Math.sin(y*0.02+t*0.28)*14;\n  const w3 = Math.sin((x+y)*0.008+t*0.18)*8;\n  const sx = x + w1 + w3, sy = y + w2 + w3;\n  const src = [\n    [120+Math.sin(t*0.4)*80, 60+Math.cos(t*0.35)*40, 0.09, 2.1, 0.8],\n    [360+Math.cos(t*0.45)*90, 80+Math.sin(t*0.5)*50, 0.11, 1.8, 1.0],\n    [80+Math.cos(t*0.55+1)*70, 180+Math.sin(t*0.4+2)*60, 0.07, 2.4, 0.9],\n    [400+Math.sin(t*0.38+3)*80, 160+Math.cos(t*0.6+1)*55, 0.085, 2.0, 0.7],\n    [240+Math.sin(t*0.3+2)*130, 100+Math.cos(t*0.42+3)*80, 0.065, 2.5, 1.1],\n    [200+Math.cos(t*0.48+4)*100, 200+Math.sin(t*0.52)*70, 0.1, 1.6, 0.85],\n    [300+Math.sin(t*0.33+5)*90, 40+Math.cos(t*0.58+2)*45, 0.075, 2.2, 0.95],\n    [160+Math.cos(t*0.44+6)*75, 140+Math.sin(t*0.37+4)*65, 0.095, 1.9, 0.75],\n    [280+Math.sin(t*0.5+1)*60, 180+Math.cos(t*0.32+5)*50, 0.055, 2.7, 1.05],\n    [50+Math.sin(t*0.6+3)*50, 110+Math.cos(t*0.45+1)*40, 0.12, 1.5, 0.65]\n  ];\n  let aS=0, iS=0, aS2=0;\n  for(const[sX,sY,f,sp,w]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const decay=1/(1+d*0.003);\n    aS+=Math.sin(d*f-t*sp)*decay*w;\n    iS+=Math.sin(d*f*0.65+t*sp*0.55+1.8)*decay*w;\n    aS2+=Math.sin(d*f*1.3-t*sp*0.8+0.5)*decay*w*0.5;\n  }\n  const act=aS/10, inh=iS/10, act2=aS2/10;\n  const bg=(Math.sin(sx*0.035+sy*0.02+t*0.9)+Math.sin(sx*0.025-sy*0.035+t*1.2))/2\n    +Math.sin((sx+sy)*0.1+t*2.8)*0.15+Math.sin((sx-sy)*0.08-t*2.2)*0.15\n    +Math.sin(sx*0.06+t*1.8)*Math.cos(sy*0.05-t*1.4)*0.12;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*3.5-t*1.6)+Math.sin(dist*0.035+ang*4.5-t*1.3)\n    +Math.sin(dist*0.06-ang*2-t*2.1))*0.3;\n  const moire=Math.sin(sx*0.2)*Math.sin(sy*0.2)+Math.sin((sx*0.7+sy*0.7)*0.1+t)*0.5;\n  const reaction=Math.tanh((act-inh*0.65+bg*0.25+spiral+act2*0.2)*2.0);\n  const cell=Math.tanh((moire+Math.sin(sx*0.12+t*0.5)*Math.sin(sy*0.12-t*0.4))*1.2)*0.2;\n  const caustic=Math.pow(Math.max(0,Math.sin(sx*0.08+sy*0.06+t*2)*Math.sin(sx*0.05-sy*0.09-t*1.7)),3)*0.4;\n  const blend=reaction*0.6+cell*0.15+caustic*0.15, v=blend*0.5+0.5;\n  const pal=[\n    [5,12,55],[12,45,95],[18,85,120],[25,130,135],[60,165,140],\n    [140,185,110],[210,190,80],[230,150,65],[215,105,75],[175,60,70],\n    [120,35,65],[65,18,55],[30,10,50],[5,12,55]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const pulse=0.85+Math.sin(reaction*Math.PI)*0.15;\n  const glow=Math.pow(Math.max(0,caustic*2),0.5)*0.3;\n  const edge=Math.abs(reaction)>0.75?1.12:1.0;\n  const lum=pulse*edge+glow;\n  return[\n    Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum+glow*60)|0,\n    Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum+glow*80)|0,\n    Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum+glow*100)|0\n  ];\n}",
