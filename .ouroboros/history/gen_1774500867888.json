  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  const w1y = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  const w2x = Math.sin(x*0.045-t*0.5)*6 + Math.cos(y*0.04+t*0.45)*4;\n  const w2y = Math.cos(y*0.05+t*0.4)*6 + Math.sin(x*0.04-t*0.55)*4;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9],\n    [80+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+2)*50, 0.14, 1.3],\n    [400+Math.cos(t*0.55+1)*60, 200+Math.sin(t*0.75+4)*55, 0.11, 2.1],\n    [200+Math.sin(t*0.7+6)*90, 220+Math.cos(t*0.3+3)*40, 0.05, 2.8],\n    [300+Math.cos(t*0.25+2)*110, 30+Math.sin(t*0.85+5)*65, 0.13, 1.6]\n  ];\n  let aS = 0, iS = 0, hS = 0;\n  for (const [sX, sY, f, sp] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    aS += Math.sin(d*f - t*sp);\n    iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5);\n    hS += Math.sin(d*f*1.4 - t*sp*1.2 + 0.8) * 0.5;\n  }\n  const act = aS/10, inh = iS/10, har = hS/10;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8) + Math.sin(sx*0.03-sy*0.04+t*1.1))/2 + Math.sin((sx+sy)*0.12+t*2.5)*0.2 + Math.sin((sx-sy)*0.1-t*2)*0.2 + Math.sin(sx*0.08+sy*0.06-t*1.8)*0.15 + Math.sin(sx*0.06-sy*0.09+t*2.2)*0.1;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cx, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5) + Math.sin(dist*0.04+ang*4-t*1.2))*0.4 + Math.sin(dist*0.08-ang*2-t*2.5)*0.2 + Math.cos(dist*0.03+ang*6-t*0.8)*0.15;\n  const reaction = Math.tanh((act - inh*0.7 + bg*0.3 + spiral + har*0.2)*2.2);\n  const cell = Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15) + Math.sin((sx+sy)*0.1+t)*0.5 + Math.sin(sx*0.08-sy*0.12+t*0.7)*0.3)*1.5)*0.3;\n  const edgeGlow = Math.pow(Math.abs(Math.sin(sx*0.15)*Math.cos(sy*0.15) + Math.sin((sx-sy)*0.1+t)*0.5), 4)*0.4;\n  const blend = reaction*0.6 + cell*0.2 + edgeGlow*0.2, v = blend*0.5+0.5;\n  const pal = [[5,12,45],[10,45,85],[15,85,120],[20,130,135],[50,170,140],[120,195,120],[200,200,80],[230,170,60],[220,110,55],[190,60,60],[130,30,55],[60,15,45],[5,12,45]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.85 + Math.sin(reaction*Math.PI)*0.15 + edgeGlow*0.2;\n  const glow = Math.max(0, 1 - dist/260) * 0.18;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum + glow*45)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum + glow*35)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum + glow*55)|0)\n  ];\n}",
