  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.25)*18 + Math.cos(y*0.013-t*0.18)*12;\n  const w1y = Math.cos(y*0.016-t*0.22)*18 + Math.sin(x*0.014+t*0.28)*12;\n  const mx = x+w1x, my = y+w1y;\n  const w2x = Math.sin(mx*0.025+t*0.4)*8 + Math.cos(my*0.02-t*0.35)*6;\n  const w2y = Math.cos(my*0.022-t*0.38)*8 + Math.sin(mx*0.019+t*0.42)*6;\n  const sx = mx+w2x, sy = my+w2y;\n  const src = [\n    [120+Math.sin(t*0.5)*90,60+Math.cos(t*0.35)*40,0.07,1.8],\n    [360+Math.cos(t*0.45)*90,60+Math.sin(t*0.55)*40,0.08,2.1],\n    [240+Math.sin(t*0.3+1)*120,40+Math.cos(t*0.4+2)*30,0.06,2.4],\n    [80+Math.cos(t*0.6+3)*70,150+Math.sin(t*0.5+1)*60,0.09,1.6],\n    [400+Math.sin(t*0.4+2)*80,150+Math.cos(t*0.7+3)*60,0.1,1.4],\n    [160+Math.cos(t*0.35+4)*100,200+Math.sin(t*0.45+2)*50,0.065,2.2],\n    [320+Math.sin(t*0.5+5)*100,200+Math.cos(t*0.55+4)*50,0.075,1.9],\n    [240+Math.sin(t*0.25+3)*140,120+Math.cos(t*0.4+1)*90,0.055,2.6],\n    [240+Math.cos(t*0.38)*60,120+Math.sin(t*0.32)*40,0.12,3.2]\n  ];\n  let aS=0,iS=0,hm=0;\n  for(const[sX,sY,f,sp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp);\n    iS+=Math.sin(d*f*0.65+t*sp*0.55+1.8);\n    hm+=Math.sin(d*f*1.3-t*sp*0.8+2.5)*Math.cos(d*f*0.4+t*sp*0.3);\n  }\n  const act=aS/9,inh=iS/9,har=hm/9;\n  const bg=(Math.sin(sx*0.035+sy*0.02+t*0.7)+Math.sin(sx*0.025-sy*0.035+t*1.0)+Math.sin((sx*0.7+sy*0.3)*0.04+t*0.9))/3+Math.sin((sx+sy)*0.1+t*2.2)*0.15+Math.sin((sx-sy)*0.08-t*1.8)*0.15+Math.sin(sx*0.06)*Math.sin(sy*0.06)*0.2;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*4-t*1.3)+Math.sin(dist*0.035+ang*5-t*1.0)+Math.sin(dist*0.06-ang*2+t*0.7))*0.33;\n  const raw=act-inh*0.6+bg*0.25+spiral*0.35+har*0.2;\n  const r1=Math.tanh(raw*2.0),r2=Math.tanh((raw+r1*0.3)*2.5),r3=Math.tanh((raw-r1*0.2+r2*0.15)*2.2);\n  const cell=Math.tanh((Math.sin(sx*0.12)*Math.sin(sy*0.12)+Math.sin((sx+sy)*0.08+t*0.8)*0.4+Math.sin(sx*0.18-t*0.5)*Math.cos(sy*0.15+t*0.3)*0.3)*1.3)*0.25;\n  const ripple=Math.sin(dist*0.08-t*2.5)*Math.exp(-dist*0.005)*0.15;\n  const blend=r3*0.65+cell*0.2+ripple*0.15,v=blend*0.5+0.5;\n  const pal=[[6,12,52],[10,40,82],[14,75,100],[18,120,115],[60,155,120],[150,175,90],[210,180,65],[220,140,60],[200,90,65],[160,55,75],[110,35,85],[65,25,80],[30,18,62],[6,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const edge=Math.abs(r3)>0.65?1.12:1.0,glow=Math.max(0,r3)*0.15,lum=(0.82+Math.sin(r3*Math.PI)*0.18)*edge+glow;\n  return[Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum)|0,Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum)|0,Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum)|0];\n}",
