  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  const w1y = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  const mx = x+w1x, my = y+w1y;\n  const w2x = Math.sin(mx*0.035-t*0.5)*8 + Math.cos(my*0.025+t*0.4)*6;\n  const w2y = Math.cos(my*0.03+t*0.45)*8 + Math.sin(mx*0.028-t*0.55)*6;\n  const sx = mx+w2x, sy = my+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 0.8],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.2],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.9],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.1],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.7],\n    [80+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+1)*50, 0.11, 2.1, 1.0],\n    [400+Math.cos(t*0.55+2)*60, 200+Math.sin(t*0.75+4)*55, 0.13, 1.8, 0.85],\n    [200+Math.sin(t*0.25+6)*110, 220+Math.cos(t*0.45+3)*65, 0.055, 2.4, 1.15],\n    [300+Math.cos(t*0.65+7)*95, 30+Math.sin(t*0.85+5)*45, 0.095, 2.0, 0.95]\n  ];\n  let aS=0, iS=0, dS=0, tw=0;\n  for (const [sX, sY, f, sp, w] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS += Math.sin(d*f-t*sp)*w;\n    iS += Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;\n    dS += Math.sin(d*f*0.4-t*sp*0.3+3.0)*w*0.5;\n    tw += w;\n  }\n  const act=aS/tw, inh=iS/tw, diff=dS/(tw*0.5);\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.06+sy*0.005-t*0.6)*0.5+Math.sin(sx*0.01+sy*0.07+t*0.9)*0.4)/2.9+Math.sin((sx+sy)*0.12+t*2.5)*0.15+Math.sin((sx-sy)*0.1-t*2)*0.15+Math.sin(sx*0.08+t*1.8)*Math.sin(sy*0.08-t*1.3)*0.2;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const sp1=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.35;\n  const sp2=(Math.sin(dist*0.07+ang*2-t*2.0)+Math.cos(dist*0.06-ang*5+t*1.8))*0.2;\n  const c1=Math.sin(sx*0.15)*Math.sin(sy*0.15), c2=Math.sin(sx*0.22+1.5)*Math.sin(sy*0.22-0.8)*0.6, c3=Math.sin((sx+sy)*0.1+t)*0.5;\n  const cell=Math.tanh((c1+c2+c3)*1.5)*0.3;\n  const rx=sx*0.5+Math.sin(t*0.3)*50, ry=sy*0.5+Math.cos(t*0.4)*40;\n  const sec=Math.sin(rx*0.1+ry*0.08-t*0.7)*Math.cos(rx*0.06-ry*0.12+t*0.9)*0.3;\n  const raw=act-inh*0.7+bg*0.3+sp1+sp2+diff*0.4+sec;\n  const reaction=Math.tanh(raw*2.0);\n  const blend=reaction*0.7+cell*0.3, v=blend*0.5+0.5;\n  const pal=[[5,12,45],[10,35,85],[15,70,120],[20,110,135],[30,150,140],[80,175,120],[170,195,80],[210,185,60],[220,150,55],[210,110,60],[185,70,55],[140,40,50],[90,22,45],[45,15,42],[5,12,45]];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i, sf=f*f*(3-2*f);\n  const lum=0.82+Math.sin(reaction*Math.PI)*0.18;\n  const edge=Math.abs(reaction)>0.85?1.2:Math.abs(reaction)>0.65?1.12:1.0;\n  const glow=Math.max(0,Math.sin(reaction*2.5)*0.15);\n  return [\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*lum*edge+glow*60)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*lum*edge+glow*40)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*lum*edge+glow*20)|0)\n  ];\n}",
