  "code": "(x, y, t) => {\n  const w1 = Math.sin(x*0.018+t*0.3)*12+Math.cos(y*0.013-t*0.22)*8;\n  const w2 = Math.cos(x*0.009-t*0.15)*20+Math.sin(y*0.011+t*0.18)*15;\n  const w3 = Math.sin((x+y)*0.007+t*0.12)*10+Math.cos((x-y)*0.008-t*0.1)*10;\n  const sx=x+w1+w2*0.5, sy=y+w2+w3*0.5;\n  const src=[\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.07,2.0,1.0],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.09,1.7,0.9],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.055,2.3,1.1],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.11,1.5,0.8],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.065,2.6,1.05],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.08,1.9,0.95],\n    [80+Math.sin(t*0.45+3)*60,40+Math.cos(t*0.65+1)*40,0.13,2.1,0.85],\n    [400+Math.cos(t*0.55+2)*70,220+Math.sin(t*0.75+4)*50,0.075,1.8,1.1],\n    [200+Math.sin(t*0.25+1)*100,200+Math.cos(t*0.45+2)*60,0.06,2.4,1.0],\n    [300+Math.cos(t*0.7+3)*80,30+Math.sin(t*0.5+5)*40,0.1,2.2,0.9]\n  ];\n  let aS=0,iS=0,harm=0;\n  for(const[sX,sY,f,sp,amp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp)*amp;\n    iS+=Math.sin(d*f*0.65+t*sp*0.55+1.5)*amp;\n    harm+=Math.sin(d*f*1.5-t*sp*1.3+0.7)*amp*0.3;\n  }\n  const n=src.length,act=aS/n,inh=iS/n;\n  const bg=(Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.028-sy*0.038+t*0.95))/2+Math.sin((sx+sy)*0.11+t*2.2)*0.15+Math.sin((sx-sy)*0.09-t*1.8)*0.15+Math.sin(sx*0.06+t*1.5)*Math.sin(sy*0.05-t*1.2)*0.2;\n  const dist=Math.sqrt((sx-240)**2+(sy-120)**2),ang=Math.atan2(sy-120,sx-240);\n  const spiral=(Math.sin(dist*0.045-ang*3.5-t*1.3)+Math.sin(dist*0.035+ang*4.5-t*1.0)+Math.sin(dist*0.025-ang*2-t*0.8))*0.3;\n  let minD=999;\n  for(let i=0;i<6;i++){\n    const cx2=80+(i%3)*160+Math.sin(t*0.3+i*1.2)*30,cy2=40+((i*97)%3)*80+Math.cos(t*0.25+i*0.9)*20;\n    const d2=Math.sqrt((sx-cx2)**2+(sy-cy2)**2);if(d2<minD)minD=d2;\n  }\n  const cell=Math.tanh(Math.sin(minD*0.12)*2.5)*0.2;\n  const ripple=Math.sin(dist*0.08-t*3)*Math.exp(-dist*0.005)*0.3;\n  const reaction=Math.tanh((act-inh*0.65+bg*0.25+spiral*0.3+harm*0.4+ripple)*2.0);\n  const blend=reaction*0.72+cell*0.28,v=blend*0.5+0.5;\n  const pal=[[6,12,52],[12,48,82],[18,82,98],[20,120,105],[55,155,100],[140,185,75],[210,185,60],[225,145,65],[215,105,75],[185,70,85],[140,50,90],[85,30,80],[40,18,65],[6,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const r=pal[i][0]+(pal[i+1][0]-pal[i][0])*f,g=pal[i][1]+(pal[i+1][1]-pal[i][1])*f,b=pal[i][2]+(pal[i+1][2]-pal[i][2])*f;\n  const lum=0.85+Math.sin(reaction*Math.PI)*0.15;\n  const edge=Math.abs(reaction)>0.6?1.0+(Math.abs(reaction)-0.6)*1.2:1.0;\n  const glow=Math.max(0,1-dist/320)*Math.abs(reaction)*0.12;\n  return[Math.min(255,(r*lum*edge+glow*90)|0),Math.min(255,(g*lum*edge+glow*70)|0),Math.min(255,(b*lum*edge+glow*50)|0)];\n}",
