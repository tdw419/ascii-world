  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.25)*20 + Math.cos(y*0.013-t*0.18)*14;\n  const w1y = Math.cos(y*0.016-t*0.22)*18 + Math.sin(x*0.015+t*0.3)*12;\n  const w2x = Math.sin((x+w1x)*0.012+t*0.15)*10 + Math.cos((y+w1y)*0.01-t*0.12)*8;\n  const w2y = Math.cos((y+w1y)*0.011-t*0.14)*9 + Math.sin((x+w1x)*0.009+t*0.17)*7;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [120+Math.sin(t*0.4)*90, 60+Math.cos(t*0.3)*40, 0.075, 2.1, 1.0],\n    [360+Math.cos(t*0.35)*80, 50+Math.sin(t*0.45)*35, 0.085, 1.8, 0.9],\n    [240+Math.sin(t*0.25+2)*130, 100+Math.cos(t*0.4+1)*70, 0.055, 2.4, 1.1],\n    [80+Math.cos(t*0.5+1)*70, 180+Math.sin(t*0.35+3)*55, 0.095, 1.6, 0.85],\n    [400+Math.sin(t*0.3+4)*85, 190+Math.cos(t*0.55+2)*60, 0.065, 2.5, 1.05],\n    [200+Math.cos(t*0.28+5)*100, 210+Math.sin(t*0.42)*65, 0.08, 2.0, 0.95],\n    [300+Math.sin(t*0.38+3)*75, 30+Math.cos(t*0.32+4)*50, 0.1, 1.4, 0.8],\n    [160+Math.cos(t*0.45+2)*95, 140+Math.sin(t*0.28+5)*75, 0.07, 2.2, 1.15]\n  ];\n  let aS=0, iS=0, aS2=0, iS2=0;\n  for (const [sX,sY,f,sp,w] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const wv = Math.sin(d*f-t*sp);\n    aS += wv*w; iS += Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;\n    const d2 = Math.sqrt((sx-sY*0.5-cx*0.5)**2+(sy-sX*0.5-cy*0.5)**2);\n    aS2 += Math.sin(d2*f*0.6-t*sp*0.8+0.7)*w*0.5;\n    iS2 += Math.sin(d2*f*0.5+t*sp*0.4+2.3)*w*0.5;\n  }\n  const tw = 8, act=(aS+aS2)/tw, inh=(iS+iS2)/tw;\n  const bg = (Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.028-sy*0.038+t*0.95))/2\n    +Math.sin((sx+sy)*0.1+t*2.2)*0.18+Math.sin((sx-sy)*0.085-t*1.8)*0.18\n    +Math.sin(sx*0.06+t*1.5)*Math.cos(sy*0.05-t*1.2)*0.12;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*3.5-t*1.3)+Math.sin(dist*0.035+ang*4.5-t*1.0))*0.35\n    +Math.sin(dist*0.08-ang*2-t*2.5)*0.15;\n  const lap = Math.sin(sx*0.08+sy*0.06+t)*0.2+Math.sin(sx*0.06-sy*0.09-t*0.7)*0.2;\n  const feed = 0.055+Math.sin(dist*0.008+t*0.2)*0.02;\n  const kill = 0.062+Math.cos(ang*2+t*0.15)*0.015;\n  const rd = Math.tanh((act-inh*0.65+bg*0.25+spiral+lap)*(1.8+feed*10)-kill*5);\n  const cell = Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14)+Math.sin((sx+sy)*0.09+t)*0.4+Math.sin(sx*0.11-sy*0.08-t*0.5)*0.3)*1.3)*0.25;\n  const micro = Math.sin(sx*0.3+t*3)*Math.sin(sy*0.25-t*2.5)*0.06;\n  const blend = rd*0.65+cell*0.25+micro*0.1, v = blend*0.5+0.5;\n  const pal = [\n    [5,12,52],[10,45,85],[15,90,115],[25,140,135],[60,175,120],\n    [170,195,70],[210,170,55],[215,120,65],[185,65,75],[120,30,65],\n    [60,18,55],[20,10,48],[5,12,52]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const lum=0.78+Math.sin(rd*Math.PI)*0.22;\n  const edge=Math.abs(rd)>0.65?1.12:1.0;\n  const glow=Math.max(0,Math.abs(rd)-0.5)*0.3;\n  return [\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*40)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*25)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*55)|0)\n  ];\n}",
