  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  const w1y = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  const w2x = Math.sin(w1x*0.05+t*0.5)*8 + Math.cos(w1y*0.04-t*0.4)*6;\n  const w2y = Math.cos(w1y*0.05-t*0.45)*8 + Math.sin(w1x*0.045+t*0.55)*6;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9],\n    [80+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+1)*50, 0.11, 2.1],\n    [400+Math.cos(t*0.55+2)*60, 220+Math.sin(t*0.75+4)*40, 0.13, 1.8],\n    [200+Math.sin(t*0.25)*110, 180+Math.cos(t*0.45+2)*70, 0.05, 2.8],\n    [300+Math.cos(t*0.7+3)*80, 100+Math.sin(t*0.5+5)*60, 0.09, 2.0]\n  ];\n  let aS = 0, iS = 0, aS2 = 0, iS2 = 0;\n  for (const [sX, sY, f, sp] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    aS += Math.sin(d*f - t*sp);\n    iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5);\n    aS2 += Math.cos(d*f*1.3 - t*sp*0.8 + 0.7);\n    iS2 += Math.sin(d*f*0.5 + t*sp*0.4 + 2.8);\n  }\n  const n = src.length;\n  const act = (aS + aS2*0.5)/(n*1.5), inh = (iS + iS2*0.5)/(n*1.5);\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8) + Math.sin(sx*0.03-sy*0.04+t*1.1))/2 + Math.sin((sx+sy)*0.12+t*2.5)*0.2 + Math.sin((sx-sy)*0.1-t*2)*0.2 + Math.sin(sx*0.08+t*0.6)*Math.sin(sy*0.06-t*0.4)*0.15;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5) + Math.sin(dist*0.04+ang*4-t*1.2))*0.4 + Math.sin(dist*0.06-ang*2-t*0.8)*0.15 + Math.sin(dist*0.03+ang*5-t*1.8)*0.1;\n  const r1 = Math.tanh((act - inh*0.7 + bg*0.3 + spiral)*2.2);\n  const r2 = Math.tanh((r1 + act*0.3 - inh*0.5)*1.8);\n  const r3 = Math.tanh((r2 + spiral*0.4 + bg*0.2)*1.5);\n  const cell = Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15) + Math.sin((sx+sy)*0.1+t)*0.5)*1.5)*0.3;\n  const cell2 = Math.tanh(Math.sin(sx*0.2-t)*Math.sin(sy*0.2+t*0.7)*1.2)*0.2;\n  const turb = Math.sin(sx*0.07+t*0.3)*Math.sin(sy*0.09-t*0.2)*Math.cos((sx+sy)*0.05+t*0.5)*0.15;\n  const blend = r3*0.55 + cell*0.2 + cell2*0.1 + turb*0.15, v = blend*0.5+0.5;\n  const pal = [[5,12,48],[12,42,82],[18,75,105],[25,120,115],[55,155,110],[140,175,85],[200,180,60],[220,140,55],[195,90,60],[150,55,65],[90,30,60],[40,18,55],[5,12,48]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.8+Math.sin(r3*Math.PI)*0.2, edge = Math.abs(r3)>0.7?1.15:1.0, glow = Math.exp(-dist*0.005)*0.15+1.0;\n  return [\n    Math.min(255, (pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge*glow)|0,\n    Math.min(255, (pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge*glow)|0,\n    Math.min(255, (pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge*glow)|0\n  ];\n}",
