  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.25)*18 + Math.cos(y*0.013-t*0.18)*12;\n  const w1y = Math.cos(y*0.016-t*0.22)*18 + Math.sin(x*0.014+t*0.3)*12;\n  const sx = x+w1x, sy = y+w1y;\n  const w2x = Math.sin(sx*0.025-t*0.4)*8 + Math.cos(sy*0.02+t*0.35)*6;\n  const w2y = Math.cos(sy*0.022+t*0.45)*8 + Math.sin(sx*0.018-t*0.38)*6;\n  const fx = sx+w2x, fy = sy+w2y;\n  const src = [\n    [160+Math.sin(t*0.5)*110, 75+Math.cos(t*0.35)*55, 0.075, 2.2, 1.0],\n    [320+Math.cos(t*0.45)*110, 165+Math.sin(t*0.6)*55, 0.095, 1.8, 0.9],\n    [240+Math.sin(t*0.28+2)*150, 115+Math.cos(t*0.42+1)*95, 0.055, 2.5, 1.1],\n    [110+Math.cos(t*0.7+1)*90, 185+Math.sin(t*0.55+3)*65, 0.11, 1.4, 0.85],\n    [370+Math.sin(t*0.38+4)*95, 55+Math.cos(t*0.8+2)*75, 0.065, 2.8, 1.15],\n    [240+Math.cos(t*0.32+5)*130, 210+Math.sin(t*0.5)*85, 0.085, 2.0, 0.95],\n    [80+Math.sin(t*0.6+3)*70, 50+Math.cos(t*0.7+4)*60, 0.1, 1.6, 1.05],\n    [400+Math.cos(t*0.4+2)*80, 190+Math.sin(t*0.65+1)*70, 0.07, 2.4, 0.88]\n  ];\n  let aS=0, iS=0, wS=0;\n  for(const[sX,sY,f,sp,w]of src){\n    const d=Math.sqrt((fx-sX)**2+(fy-sY)**2);\n    const att=1/(1+d*0.003);\n    aS+=Math.sin(d*f-t*sp)*w*att;\n    iS+=Math.sin(d*f*0.65+t*sp*0.55+1.7)*w*att;\n    wS+=Math.sin(d*f*1.3-t*sp*0.8+3.1)*w*att*0.5;\n  }\n  const act=aS/8, inh=iS/8, wav=wS/8;\n  const bg=(Math.sin(fx*0.035+fy*0.022+t*0.7)+Math.sin(fx*0.028-fy*0.038+t*1.05)+Math.sin(fx*0.05+fy*0.01-t*0.9))/3;\n  const fine=(Math.sin(fx*0.09+fy*0.07+t*1.8)+Math.sin(fx*0.07-fy*0.09+t*2.2))*0.15;\n  const dist=Math.sqrt((fx-cx)**2+(fy-cy)**2), ang=Math.atan2(fy-cy,fx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*3.5-t*1.4)+Math.sin(dist*0.035+ang*4.5-t*1.1)+Math.sin(dist*0.06-ang*2-t*1.8))*0.28;\n  const rd1=Math.tanh((act-inh*0.65+bg*0.35+spiral+fine)*2.5);\n  const rd2=Math.tanh((act*0.8-inh*0.9+wav*0.4+spiral*0.7-fine*0.5)*2.0);\n  const lap=Math.sin(fx*0.15)*Math.sin(fy*0.15)+Math.sin((fx+fy)*0.08+t*0.6)*0.6+Math.sin((fx-fy)*0.1-t*0.8)*0.4;\n  const cell=Math.tanh(lap*1.8)*0.25;\n  const edge=1-(1-Math.abs(rd1))*(1-Math.abs(rd2))*0.6;\n  const blend=rd1*0.5+rd2*0.25+cell*0.15+edge*0.1;\n  const v=blend*0.5+0.5;\n  const pal=[\n    [6,14,62],[10,42,95],[14,75,120],[18,118,135],\n    [35,155,140],[120,175,110],[195,185,80],\n    [220,165,75],[210,130,80],[185,90,75],\n    [150,55,70],[100,30,60],[55,18,52],[6,14,62]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const lum=0.78+Math.sin(rd1*Math.PI)*0.15+Math.abs(rd2)*0.07;\n  const glow=Math.max(0,rd1*rd2)*0.3;\n  const hl=edge>0.4?1.2+edge*0.15:1.0;\n  return[\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*hl+glow*60))|0,\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*hl+glow*40))|0,\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*hl+glow*30))|0\n  ];\n}",
