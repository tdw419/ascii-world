{
  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.015+t*0.2)*20 + Math.cos(y*0.012-t*0.15)*15;\n  const w1y = Math.cos(y*0.015-t*0.18)*20 + Math.sin(x*0.013+t*0.22)*15;\n  const w2x = Math.sin((x+w1x)*0.025+t*0.35)*8 + Math.cos((y+w1y)*0.02-t*0.3)*6;\n  const w2y = Math.cos((y+w1y)*0.025-t*0.32)*8 + Math.sin((x+w1x)*0.022+t*0.38)*6;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 0.9],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.1],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.8],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.2],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.95],\n    [80+Math.sin(t*0.45+3)*110, 120+Math.cos(t*0.65+4)*70, 0.11, 2.1, 0.85],\n    [400+Math.cos(t*0.55+2)*70, 200+Math.sin(t*0.75+1)*60, 0.075, 2.4, 1.05],\n    [200+Math.sin(t*0.25+6)*130, 40+Math.cos(t*0.45+5)*90, 0.065, 1.8, 1.15],\n    [300+Math.cos(t*0.7+3)*90, 220+Math.sin(t*0.5+2)*50, 0.095, 2.2, 0.9]\n  ];\n  let aS=0, iS=0, wW=0;\n  for (const [sX,sY,f,sp,w] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const fo = 1.0/(1.0+d*0.004);\n    aS += Math.sin(d*f-t*sp)*fo*w;\n    iS += Math.sin(d*f*0.7+t*sp*0.6+1.5)*fo*w;\n    wW += fo*w;\n  }\n  const act=aS/wW, inh=iS/wW;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.02+sy*0.05-t*0.9))/3\n    +Math.sin((sx+sy)*0.12+t*2.5)*0.15+Math.sin((sx-sy)*0.1-t*2)*0.15+Math.sin(sx*0.06-sy*0.03+t*1.8)*0.1;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.07-ang*2+t*0.8)*0.5)*0.3;\n  const act2=Math.sin(sx*0.08+t*0.5)*Math.cos(sy*0.06-t*0.3)+Math.sin((sx-sy)*0.05+t*0.7);\n  const inh2=Math.cos(sx*0.1-t*0.4)*Math.sin(sy*0.09+t*0.6)+Math.cos((sx+sy)*0.07-t*0.5);\n  const rd2=Math.tanh((act2-inh2*0.8)*1.5)*0.4;\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+Math.sin(sx*0.08-sy*0.12+t*0.8)*0.3)*1.5)*0.25;\n  const reaction=Math.tanh((act-inh*0.7+bg*0.25+spiral+rd2)*2.0);\n  const blend=reaction*0.65+cell*0.2+rd2*0.15, v=blend*0.5+0.5;\n  const pal=[[6,12,52],[12,55,95],[18,120,125],[45,165,135],[180,195,80],[220,175,60],[210,110,65],[175,55,60],[110,25,55],[55,15,65],[20,12,58],[6,12,52]];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i, sf=f*f*(3-2*f);\n  const lum=0.75+Math.sin(reaction*Math.PI)*0.25;\n  const edge=Math.abs(reaction)>0.75?1.2:(Math.abs(reaction)>0.5?1.05:0.95);\n  const glow=Math.max(0,reaction*0.3)*(1.0+Math.sin(t*3)*0.1);\n  return [\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*lum*edge+glow*30)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*lum*edge+glow*20)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*lum*edge+glow*40)|0)\n  ];\n}",
