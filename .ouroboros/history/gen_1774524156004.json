  "code": "(x, y, t) => {\n  const wx1 = Math.sin(x*0.02+t*0.3)*15+Math.cos(y*0.015-t*0.2)*10;\n  const wy1 = Math.cos(y*0.02-t*0.25)*15+Math.sin(x*0.018+t*0.35)*10;\n  const sx = x+wx1, sy = y+wy1;\n  const wx2 = Math.sin(sx*0.015+sy*0.01+t*0.15)*8;\n  const wy2 = Math.cos(sx*0.01-sy*0.015+t*0.12)*8;\n  const sx2 = sx+wx2, sy2 = sy+wy2;\n  const src = [\n    [240+Math.sin(t*0.6)*100,120+Math.cos(t*0.4)*50,0.08,2.0],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9],\n    [80+Math.sin(t*0.45+3)*60,40+Math.cos(t*0.65)*50,0.14,1.3],\n    [400+Math.cos(t*0.55+2)*70,200+Math.sin(t*0.75+1)*55,0.11,1.8],\n    [200+Math.sin(t*0.25+1)*110,220+Math.cos(t*0.45+4)*65,0.05,2.8]\n  ];\n  let aS=0,iS=0;\n  for(const[sX,sY,f,sp]of src){\n    const d=Math.sqrt((sx2-sX)**2+(sy2-sY)**2);\n    aS+=Math.sin(d*f-t*sp);\n    iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5);\n  }\n  const act=aS/9,inh=iS/9;\n  const bg=(Math.sin(sx2*0.04+sy2*0.025+t*0.8)+Math.sin(sx2*0.03-sy2*0.04+t*1.1))/2+Math.sin((sx2+sy2)*0.12+t*2.5)*0.2+Math.sin((sx2-sy2)*0.1-t*2)*0.2+Math.sin(sx2*0.08+t*0.5)*Math.sin(sy2*0.06-t*0.3)*0.15;\n  const cx=240,cy=120,dist=Math.sqrt((sx2-cx)**2+(sy2-cy)**2),ang=Math.atan2(sy2-cy,sx2-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.03-ang*5+t*0.8)*0.5)*0.35;\n  const spiral2=Math.sin(dist*0.06+ang*2-t*1.8)*Math.cos(dist*0.04-ang*3+t*1.1)*0.2;\n  const r1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2);\n  const r2=Math.tanh((act*0.6+inh*0.4-bg*0.2+spiral2)*1.8);\n  const cell=Math.tanh((Math.sin(sx2*0.15)*Math.sin(sy2*0.15)+Math.sin((sx2+sy2)*0.1+t)*0.5)*1.5)*0.3;\n  const blend=r1*0.5+r2*0.25+cell*0.25,v=blend*0.5+0.5;\n  const pal=[[5,12,48],[12,38,88],[18,78,108],[25,135,128],[90,170,110],[185,175,55],[215,135,62],[190,68,58],[135,32,52],[65,18,48],[25,14,58],[5,12,48]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.8+Math.sin(r1*Math.PI)*0.2+Math.sin(t*0.5)*0.05;\n  const eM=Math.abs(r1),edge=eM>0.65?1.0+(eM-0.65)*1.5:1.0;\n  const hl=r2>0.5?(r2-0.5)*0.3:0;\n  return[\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+hl*40)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+hl*30)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+hl*15)|0)\n  ];\n}",
