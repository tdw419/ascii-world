  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.02+t*0.3)*15 + Math.cos(y*0.015-t*0.2)*10;\n  const w1y = Math.cos(y*0.02-t*0.25)*15 + Math.sin(x*0.018+t*0.35)*10;\n  const w2x = Math.sin(w1x*0.05+t*0.5)*8 + Math.cos(w1y*0.04-t*0.4)*6;\n  const w2y = Math.cos(w1y*0.05-t*0.45)*8 + Math.sin(w1x*0.045+t*0.55)*6;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0,0.5],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7,0.6],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3,0.4],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5,0.7],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6,0.3],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9,0.55],\n    [60+Math.sin(t*0.45+3)*70,40+Math.cos(t*0.65+2)*50,0.14,2.1,0.45],\n    [420+Math.cos(t*0.55+1)*60,200+Math.sin(t*0.75+4)*40,0.11,1.8,0.65]\n  ];\n  let aS=0,iS=0,a2=0,i2=0,wT=0;\n  for(const[sX,sY,f,sp,w]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp)*w; iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5)*w;\n    a2+=Math.sin(d*f*1.3-t*sp*0.8+2)*w; i2+=Math.cos(d*f*0.5+t*sp*0.4-1)*w; wT+=w;\n  }\n  const act=aS/wT,inh=iS/wT,act2=a2/wT,inh2=i2/wT;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.07-sy*0.02+t*1.6)*0.5)/2.5\n    +Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2+Math.sin(sx*0.09+sy*0.11-t*1.8)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.07-ang*2+t*0.9)*0.5)*0.3;\n  const r1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2);\n  const r2=Math.tanh((act2-inh2*0.6+r1*0.4)*2.0);\n  const comb=r1*0.7+r2*0.3;\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+Math.sin(sx*0.08-sy*0.12+t*0.7)*0.3)*1.5)*0.3;\n  const v=(comb*0.7+cell*0.3)*0.5+0.5;\n  const pal=[[12,15,55],[20,50,95],[25,110,130],[45,170,150],[180,195,80],[225,175,55],[210,110,65],[175,65,85],[120,35,90],[60,20,70],[12,15,55]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.8+Math.sin(comb*Math.PI)*0.2,edge=Math.abs(comb)>0.65?1.12:1.0,glow=Math.max(0,comb*0.5)*0.15;\n  return[\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*60)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*40)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*20)|0)\n  ];\n}",
