  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1 = Math.sin(x*0.018+t*0.3)*18+Math.cos(y*0.012-t*0.22)*12;\n  const w2 = Math.cos(x*0.025-t*0.18)*10+Math.sin(y*0.02+t*0.28)*14;\n  const w3 = Math.sin((x+y)*0.008+t*0.15)*8;\n  const sx = x+w1+w3, sy = y+w2+w3;\n  const src = [\n    [160+Math.sin(t*0.55)*110, 80+Math.cos(t*0.38)*55, 0.075, 2.1, 0],\n    [320+Math.cos(t*0.48)*100, 160+Math.sin(t*0.65)*50, 0.095, 1.8, 1.2],\n    [240+Math.sin(t*0.32+2)*145, 120+Math.cos(t*0.52+1)*95, 0.055, 2.4, 2.5],\n    [120+Math.cos(t*0.75+1)*85, 180+Math.sin(t*0.58+3)*65, 0.11, 1.6, 3.8],\n    [360+Math.sin(t*0.42+4)*95, 60+Math.cos(t*0.85+2)*75, 0.065, 2.7, 5.1],\n    [240+Math.cos(t*0.33+5)*125, 200+Math.sin(t*0.5)*85, 0.085, 2.0, 6.3],\n    [80+Math.sin(t*0.6+3)*70, 40+Math.cos(t*0.45+1)*50, 0.13, 1.4, 4.5],\n    [400+Math.cos(t*0.5+2)*60, 220+Math.sin(t*0.7+4)*45, 0.07, 2.5, 1.8]\n  ];\n  let aS=0, iS=0, cS=0;\n  for (const [sX,sY,f,sp,ph] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS += Math.sin(d*f-t*sp+ph);\n    iS += Math.sin(d*f*0.65+t*sp*0.55+ph+1.7);\n    cS += Math.cos(d*f*1.3-t*sp*0.4+ph*0.5)*0.5;\n  }\n  const n=8, act=aS/n, inh=iS/n, cou=cS/n;\n  const bg = (Math.sin(sx*0.035+sy*0.022+t*0.75)+Math.sin(sx*0.028-sy*0.038+t*1.05))/2\n    + Math.sin((sx+sy)*0.11+t*2.3)*0.18+Math.sin((sx-sy)*0.095-t*1.8)*0.18\n    + Math.sin(sx*0.065+Math.cos(t*0.3)*2)*Math.sin(sy*0.055+Math.sin(t*0.4)*2)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral = (Math.sin(dist*0.045-ang*3.5-t*1.4)+Math.sin(dist*0.035+ang*4.5-t*1.1)\n    +Math.sin(dist*0.025-ang*2-t*0.8))*0.35;\n  const toroid = Math.sin(Math.sqrt((sx-240)**2*0.0003+(sy-120)**2*0.001)*80-t*2)*0.15;\n  const mobius = Math.sin(ang*2+t*0.5)*Math.cos(dist*0.02-t)*0.1;\n  const rd1 = Math.tanh((act-inh*0.65+bg*0.28+spiral+toroid+mobius)*2.0);\n  const rd2 = Math.tanh((cou*0.5+act*inh*0.3+spiral*0.4-bg*0.15)*1.8);\n  const cellA = Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14)+Math.sin((sx+sy)*0.095+t)*0.45)*1.4)*0.25;\n  const cellB = Math.tanh((Math.cos(sx*0.11-sy*0.08+t*0.6)*Math.sin(sx*0.07+sy*0.12-t*0.4))*1.2)*0.15;\n  const blend = rd1*0.5+rd2*0.2+cellA*0.2+cellB*0.1;\n  const v = blend*0.5+0.5;\n  const edge = 1.0+Math.pow(Math.abs(rd1),3)*0.25;\n  const pal = [\n    [5,12,52],[10,45,88],[14,85,115],[18,130,128],[55,165,120],\n    [140,190,95],[210,185,70],[225,150,65],[215,105,60],[180,65,60],\n    [120,35,55],[65,18,48],[25,10,42],[5,12,52]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const lum = 0.82+Math.sin(rd1*Math.PI*1.1)*0.18+rd2*0.08;\n  return [\n    Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge)|0,\n    Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge)|0,\n    Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge)|0\n  ];\n}",
