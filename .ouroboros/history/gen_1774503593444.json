  "code": "(x, y, t) => {\n  const wx = Math.sin(x*0.02+t*0.3)*15+Math.cos(y*0.015-t*0.2)*10+Math.sin(x*0.04+y*0.03+t*0.7)*5+Math.cos(x*0.008-t*0.15)*20;\n  const wy = Math.cos(y*0.02-t*0.25)*15+Math.sin(x*0.018+t*0.35)*10+Math.cos(x*0.025-y*0.02-t*0.5)*6+Math.sin(y*0.01+t*0.1)*18;\n  const sx = x+wx, sy = y+wy;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9],\n    [80+Math.sin(t*0.45+3)*110,40+Math.cos(t*0.65+1)*60,0.14,1.3],\n    [400+Math.cos(t*0.55+2)*70,200+Math.sin(t*0.75+4)*50,0.05,2.8],\n    [200+Math.sin(t*0.25+6)*130,220+Math.cos(t*0.45+3)*40,0.11,1.6],\n    [300+Math.cos(t*0.7+5)*90,30+Math.sin(t*0.3+2)*80,0.09,2.1]\n  ];\n  let aS=0,iS=0,aS2=0,iS2=0;\n  for(const[sX,sY,f,sp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp); iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5);\n    aS2+=Math.sin(d*f*1.8-t*sp*1.3+0.7)*0.5; iS2+=Math.cos(d*f*1.4+t*sp*0.9+2.3)*0.5;\n  }\n  const n=src.length, act=aS/n+aS2/n, inh=iS/n+iS2/n;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1))/2+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2+Math.sin(sx*0.07*Math.cos(t*0.2)+sy*0.05*Math.sin(t*0.3)+t*1.5)*0.15;\n  const cx=240,cy=120,dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.4+Math.sin(dist*0.08+ang*2-t*2.5)*0.15+Math.cos(dist*0.03-ang*5+t*0.8)*0.1;\n  const r1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2), fb=Math.sin(r1*3.5+t*0.5)*0.3;\n  const r2=Math.tanh((act*0.8-inh*0.9+bg*0.2+spiral*1.2+fb)*1.8), reaction=r1*0.65+r2*0.35;\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5)*1.5)*0.3;\n  const fine=Math.sin(sx*0.3+t*3)*Math.sin(sy*0.3-t*2.5)*0.08;\n  const v=(reaction*0.6+cell*0.25+fine)*0.5+0.5;\n  const pal=[[5,12,45],[10,40,85],[15,75,120],[25,120,130],[60,160,120],[140,180,90],[200,175,75],[220,140,70],[210,100,75],[180,65,85],[120,35,75],[60,20,55],[25,12,42],[5,12,45]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i,sf=f*f*(3-2*f);\n  const lum=0.85+Math.sin(reaction*Math.PI)*0.15+Math.abs(r2)*0.1,edge=Math.abs(reaction)>0.65?1.12:1.0,glow=Math.max(0,reaction-0.5)*0.3;\n  return[\n    Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*lum*edge+glow*40)|0),\n    Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*lum*edge+glow*20)|0),\n    Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*lum*edge+glow*30)|0)\n  ];\n}",
