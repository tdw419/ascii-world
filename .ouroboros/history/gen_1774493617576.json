  "code": "(x, y, t) => {\n  const w1x = Math.sin(x*0.012+t*0.2)*20+Math.cos(y*0.015-t*0.15)*15;\n  const w1y = Math.cos(y*0.013-t*0.18)*18+Math.sin(x*0.016+t*0.22)*12;\n  const w2x = Math.sin((x+w1x)*0.008+t*0.12)*30+Math.cos((y+w1y)*0.01-t*0.1)*25;\n  const w2y = Math.cos((y+w1y)*0.009-t*0.14)*28+Math.sin((x+w1x)*0.011+t*0.16)*20;\n  const sx=x+w1x+w2x, sy=y+w1y+w2y;\n  const src=[\n    [240+Math.cos(t*0.4)*120,120+Math.sin(t*0.3)*70,0.07,2.0],\n    [240+Math.cos(t*0.4+2.094)*120,120+Math.sin(t*0.3+2.094)*70,0.065,1.8],\n    [240+Math.cos(t*0.4+4.189)*120,120+Math.sin(t*0.3+4.189)*70,0.075,2.2],\n    [160+Math.sin(t*0.55)*90,80+Math.cos(t*0.45)*55,0.09,1.6],\n    [320+Math.cos(t*0.5)*90,160+Math.sin(t*0.6)*55,0.085,1.9],\n    [100+Math.cos(t*0.7+1)*70,180+Math.sin(t*0.5+2)*50,0.11,1.4],\n    [380+Math.sin(t*0.45+3)*80,60+Math.cos(t*0.65+1)*60,0.1,1.7],\n    [200+Math.sin(t*0.35+4)*100,200+Math.cos(t*0.55)*80,0.08,2.1],\n    [300+Math.cos(t*0.6+5)*90,40+Math.sin(t*0.4+3)*50,0.095,1.5]\n  ];\n  let aS=0,iS=0,aS2=0,iS2=0,minD=999,secD=999;\n  for(const[sX,sY,f,sp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp); iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5);\n    aS2+=Math.sin(d*f*2.3-t*sp*1.4+0.8); iS2+=Math.sin(d*f*1.6+t*sp*0.9+2.2);\n    if(d<minD){secD=minD;minD=d}else if(d<secD)secD=d;\n  }\n  const n=9,act=aS/n,inh=iS/n,act2=aS2/n,inh2=iS2/n;\n  const bg=(Math.sin(sx*0.035+sy*0.022+t*0.7)+Math.sin(sx*0.028-sy*0.038+t*1.0)+Math.sin(sx*0.045+sy*0.01-t*0.5))/3;\n  const micro=(Math.sin(sx*0.12+sy*0.08+t*1.8)*Math.cos(sx*0.09-sy*0.11+t*1.3)+Math.sin((sx+sy)*0.15-t*2.2)*0.5)/1.5;\n  const cx=240,cy=120,dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const sp1=(Math.sin(dist*0.045-ang*3-t*1.3)+Math.sin(dist*0.035+ang*4-t*1.0))*0.35;\n  const sp2=Math.sin(dist*0.08+ang*2-t*1.8)*0.2;\n  const vor=Math.tanh((secD-minD)*0.15-0.5)*0.4;\n  const rx=Math.tanh((act-inh*0.65+bg*0.35+sp1+sp2)*2.0);\n  const fd=Math.tanh((act2-inh2*0.6+micro*0.4)*2.5);\n  const cb=rx*0.7+fd*0.2+vor*0.1;\n  const pulse=0.9+Math.sin(t*0.8)*0.1+Math.sin(t*1.6)*0.05;\n  const v=Math.tanh(cb*pulse)*0.5+0.5;\n  const pal=[[5,12,52],[10,40,85],[18,75,105],[25,120,120],[45,155,120],[140,185,100],[210,195,70],[230,150,65],[220,100,70],[180,60,80],[120,35,75],[60,20,65],[20,15,55],[5,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.85+Math.sin(cb*Math.PI)*0.15;\n  const edge=Math.abs(cb)>0.9?1.2:Math.abs(cb)>0.65?1.12:1.0;\n  return[\n    Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge)|0,\n    Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge)|0,\n    Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge)|0\n  ];\n}",
