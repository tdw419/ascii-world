  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(y*0.018+t*0.25)*20+Math.sin((x+y)*0.01+t*0.15)*12;\n  const w1y = Math.cos(x*0.02-t*0.2)*18+Math.cos((x-y)*0.012-t*0.18)*14;\n  const x1 = x+w1x, y1 = y+w1y;\n  const w2x = Math.sin(y1*0.025-t*0.35)*10+Math.cos(x1*0.015+t*0.4)*8;\n  const w2y = Math.cos(x1*0.022+t*0.3)*12+Math.sin(y1*0.018-t*0.45)*7;\n  const sx = x1+w2x, sy = y1+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9],\n    [80+Math.sin(t*0.45+1.5)*70,40+Math.cos(t*0.65+2.5)*50,0.14,2.1],\n    [400+Math.cos(t*0.55+3)*60,200+Math.sin(t*0.75+1)*45,0.11,1.8],\n    [200+Math.sin(t*0.38+4.5)*110,220+Math.cos(t*0.58+0.5)*70,0.085,2.4],\n    [300+Math.cos(t*0.42+2)*90,30+Math.sin(t*0.52+3.5)*55,0.095,2.0]\n  ];\n  let aS=0,iS=0;\n  for(const[sX,sY,f,sp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp);\n    iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5);\n  }\n  const act=aS/10,inh=iS/10;\n  const bg1=Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1);\n  const bg2=Math.sin(sx*0.08+sy*0.05-t*1.5)*0.5+Math.sin(sx*0.06-sy*0.09+t*1.8)*0.5;\n  const bg3=Math.sin(sx*0.16+sy*0.1+t*2.5)*0.25+Math.sin(sx*0.14-sy*0.18-t*2.2)*0.25;\n  const bg=(bg1+bg2+bg3)/3;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.08-ang*2+t*2)*0.5)/2.5;\n  const vein=Math.sin(sx*0.1+Math.sin(sy*0.08+t*0.5)*3)*Math.cos(sy*0.12+Math.sin(sx*0.06-t*0.4)*2.5);\n  const rd1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2);\n  const rd2=Math.tanh((rd1*1.5-Math.sin(sx*0.07+sy*0.05+t)*0.8+vein*0.4)*2.0);\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5)*1.5)*0.3;\n  const blend=rd2*0.55+rd1*0.2+cell*0.25,v=blend*0.5+0.5;\n  const pal=[[5,12,52],[12,45,85],[18,95,115],[25,155,135],[120,190,100],[210,195,60],[235,145,55],[210,85,65],[160,45,70],[90,25,65],[40,15,55],[5,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i,sf=f*f*(3-2*f);\n  const energy=Math.abs(rd2),lum=0.85+energy*0.15,glow=energy>0.6?1.0+(energy-0.6)*0.4:1.0,edge=Math.abs(blend)>0.7?1.12:1.0,bright=lum*glow*edge;\n  return[\n    Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*bright)|0,\n    Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*bright)|0,\n    Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*bright)|0\n  ];\n}",
