  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const n1 = Math.sin(x*0.013+t*0.2)*Math.cos(y*0.017-t*0.15);\n  const n2 = Math.cos(x*0.019-t*0.18)*Math.sin(y*0.011+t*0.22);\n  const n3 = Math.sin((x+y)*0.008+t*0.12)*Math.cos((x-y)*0.009-t*0.1);\n  const wx = n1*20+n2*12+Math.sin(y*0.025-t*0.3)*8;\n  const wy = n2*20+n3*12+Math.cos(x*0.025+t*0.3)*8;\n  const sx = x+wx, sy = y+wy;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0,0],[320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7,0.5],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3,1],[120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5,1.5],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6,2],[240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9,2.5],\n    [80+Math.sin(t*0.45+3)*70,40+Math.cos(t*0.65)*50,0.11,2.1,3],[400+Math.cos(t*0.55+1)*60,200+Math.sin(t*0.75+2)*40,0.085,1.8,3.5],\n    [200+Math.sin(t*0.38+4)*90,220+Math.cos(t*0.48)*70,0.095,2.4,4],[300+Math.cos(t*0.42+2)*110,100+Math.sin(t*0.62+1)*60,0.075,2.2,4.5]\n  ];\n  let aS=0,iS=0,hS=0;\n  for(const[sX,sY,f,sp,ph]of src){const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);aS+=Math.sin(d*f-t*sp+ph);iS+=Math.sin(d*f*0.7+t*sp*0.6+ph+1.5);hS+=Math.cos(d*f*0.5-t*sp*0.3+ph*0.5)*0.5;}\n  const act=aS/10,inh=iS/10,harm=hS/10;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.07+sy*0.06-t*1.5)*0.5+Math.sin(sx*0.12-sy*0.09+t*2.2)*0.25)/2.75+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.06-ang*2+t*0.9)*0.6+Math.sin(dist*0.035+ang*5-t*1.8)*0.4)*0.35;\n  const rd1=Math.tanh((act-inh*0.7+0.055)*3),rd2=Math.tanh((inh-act*0.6-0.062+harm*0.3)*2.5);\n  const reaction=rd1*(1-rd2*0.5);\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+Math.sin(sx*0.22-sy*0.18+t*0.7)*0.3)*1.5)*0.3;\n  const fine=Math.sin(sx*0.4+t*3)*Math.sin(sy*0.4-t*2.5)*0.1;\n  const blend=reaction*0.6+cell*0.2+spiral*0.15+fine*0.05,v=blend*0.5+0.5;\n  const pal=[[6,12,52],[12,42,82],[18,88,108],[28,138,128],[85,165,95],[185,175,60],[218,145,55],[195,85,60],[145,48,72],[85,28,88],[42,18,68],[6,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.85+Math.sin(reaction*Math.PI)*0.15;\n  const edge=Math.abs(reaction)>0.75?1.2:Math.abs(reaction)>0.5?1.05:0.95;\n  const hs=harm*0.15;\n  return[Math.min(255,Math.max(0,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f+hs*30)*lum*edge))|0,Math.min(255,Math.max(0,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f+hs*15)*lum*edge))|0,Math.min(255,Math.max(0,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f-hs*20)*lum*edge))|0];\n}",
