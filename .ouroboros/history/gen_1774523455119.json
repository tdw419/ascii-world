  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.013-t*0.22)*12;\n  const w1y = Math.cos(y*0.02-t*0.27)*18 + Math.sin(x*0.016+t*0.33)*12;\n  const w2x = Math.sin((x+w1x)*0.025-t*0.45)*8 + Math.cos((y+w1y)*0.02+t*0.38)*6;\n  const w2y = Math.cos((y+w1y)*0.022+t*0.42)*8 + Math.sin((x+w1x)*0.019-t*0.5)*6;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.075, 2.1, 0.9],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.09, 1.8, 1.1],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.055, 2.4, 0.8],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.11, 1.6, 1.2],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.065, 2.7, 0.7],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.085, 2.0, 1.0],\n    [80+Math.sin(t*0.7+3)*70, 40+Math.cos(t*0.45+4)*50, 0.1, 1.4, 1.3],\n    [400+Math.cos(t*0.55+2)*60, 220+Math.sin(t*0.65+1)*40, 0.07, 2.2, 0.85],\n    [200+Math.sin(t*0.25+6)*110, 50+Math.cos(t*0.75+3)*70, 0.06, 2.5, 0.75]\n  ];\n  let aS=0, iS=0, aS2=0, iS2=0;\n  for (const [sX,sY,f,sp,ph] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    const d2 = Math.sqrt((sx*0.5-sX*0.5)**2+(sy*0.5-sY*0.5)**2);\n    aS += Math.sin(d*f-t*sp+ph);\n    iS += Math.sin(d*f*0.68+t*sp*0.55+1.5+ph);\n    aS2 += Math.sin(d2*f*1.8-t*sp*0.7+ph*2)*0.5;\n    iS2 += Math.sin(d2*f*1.3+t*sp*0.45+2.0+ph*1.5)*0.5;\n  }\n  const act=(aS+aS2)/13.5, inh=(iS+iS2)/13.5;\n  const bg = (Math.sin(sx*0.035+sy*0.022+t*0.75)+Math.sin(sx*0.028-sy*0.038+t*1.05))/2\n    +Math.sin((sx+sy)*0.11+t*2.3)*0.18+Math.sin((sx-sy)*0.09-t*1.8)*0.18\n    +Math.sin(sx*0.06+t*1.5)*Math.cos(sy*0.05-t*1.2)*0.12;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2), ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.045-ang*3.5-t*1.4)+Math.sin(dist*0.038+ang*4.5-t*1.1))*0.35\n    +Math.sin(dist*0.08-ang*2-t*2.5)*0.15;\n  const pulse = Math.sin(t*0.8)*0.08;\n  const reaction = Math.tanh((act-inh*0.65+bg*0.35+spiral+pulse)*2.0);\n  const cell = Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14)+Math.sin((sx+sy)*0.095+t)*0.5)*1.4)*0.25;\n  const micro = Math.tanh(Math.sin(sx*0.3+t*2)*Math.sin(sy*0.35-t*1.7)*1.8)*0.08;\n  const edge = 1.0-Math.pow(Math.abs(reaction),3)*0.3;\n  const blend = reaction*0.65+cell*0.25+micro*0.1, v = blend*0.5+0.5;\n  const pal = [\n    [5,12,52],[10,42,88],[12,72,105],[18,115,120],[35,155,130],\n    [130,175,90],[200,185,60],[215,140,55],[195,85,65],[155,45,70],\n    [95,25,75],[50,15,58],[5,12,52]\n  ];\n  const idx=v*(pal.length-1), i=Math.min(idx|0,pal.length-2), f=idx-i;\n  const sf=f*f*(3-2*f);\n  const lum = 0.82+Math.sin(reaction*Math.PI)*0.18;\n  const glow = Math.pow(Math.max(0,reaction),2)*0.25;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*lum*edge+glow*60)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*lum*edge+glow*45)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*lum*edge+glow*30)|0)\n  ];\n}",
