  "code": "(x, y, t) => {\n  const w1x = Math.sin(x*0.015+t*0.2)*20 + Math.cos(y*0.012-t*0.15)*15;\n  const w1y = Math.cos(y*0.018-t*0.18)*18 + Math.sin(x*0.014+t*0.22)*12;\n  const w2x = Math.sin((x+w1x)*0.008+t*0.1)*25 + Math.cos((y+w1y)*0.006-t*0.08)*20;\n  const w2y = Math.cos((y+w1y)*0.009-t*0.12)*22 + Math.sin((x+w1x)*0.007+t*0.09)*18;\n  const sx = x + w1x + w2x*0.5, sy = y + w1y + w2y*0.5;\n  const src = [\n    [120+Math.sin(t*0.5)*80, 60+Math.cos(t*0.4)*40, 0.07, 2.0, 0.0],\n    [360+Math.cos(t*0.6)*80, 60+Math.sin(t*0.5)*40, 0.09, 1.8, 1.2],\n    [240+Math.sin(t*0.35+2)*120, 120+Math.cos(t*0.45+1)*70, 0.055, 2.4, 2.4],\n    [80+Math.cos(t*0.7+1)*60, 180+Math.sin(t*0.55+3)*50, 0.11, 1.5, 3.6],\n    [400+Math.sin(t*0.45+4)*70, 180+Math.cos(t*0.8+2)*50, 0.065, 2.2, 4.8],\n    [240+Math.cos(t*0.3+5)*100, 220+Math.sin(t*0.5)*60, 0.08, 1.9, 6.0],\n    [180+Math.sin(t*0.55+3)*90, 30+Math.cos(t*0.65+4)*50, 0.1, 1.6, 1.8],\n    [300+Math.cos(t*0.4+2)*90, 200+Math.sin(t*0.7+1)*70, 0.075, 2.1, 5.4],\n    [60+Math.sin(t*0.65)*50, 120+Math.cos(t*0.5+2)*80, 0.12, 1.4, 0.8],\n    [420+Math.cos(t*0.55+1)*60, 100+Math.sin(t*0.45+3)*60, 0.085, 2.0, 4.2]\n  ];\n  let act=0,inh=0,act2=0,inh2=0;\n  for(const[sX,sY,f,sp,ph]of src){const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);act+=Math.sin(d*f-t*sp+ph);inh+=Math.sin(d*f*0.7+t*sp*0.5+ph*0.8+1.5);act2+=Math.sin(d*f*1.5-t*sp*1.3+ph*0.5+2.0);inh2+=Math.sin(d*f*1.1+t*sp*0.8+ph*1.2+0.7);}\n  act/=10;inh/=10;act2/=10;inh2/=10;\n  const bg1=(Math.sin(sx*0.035+sy*0.02+t*0.7)+Math.sin(sx*0.025-sy*0.035+t*0.9))/2;\n  const bg2=Math.sin((sx+sy)*0.1+t*2.2)*0.3+Math.sin((sx-sy)*0.08-t*1.8)*0.3;\n  const bg3=Math.sin(sx*0.06+t*1.5)*Math.sin(sy*0.06-t*1.2)*0.4;\n  const bg=bg1+bg2+bg3;\n  const cx=240,cy=120,dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const sp1=Math.sin(dist*0.04-ang*3-t*1.3)*0.5,sp2=Math.sin(dist*0.06+ang*2-t*0.9+1.0)*0.3;\n  const spiral=(sp1+sp2)*Math.exp(-dist*0.003);\n  const breath=1.0+Math.sin(t*0.4)*0.08;\n  const rd1=Math.tanh((act-inh*0.65+bg*0.25+spiral)*2.0*breath);\n  const rd2=Math.tanh((act2-inh2*0.6+bg*0.15-spiral*0.3)*2.5*breath);\n  const cell=Math.tanh((Math.sin(sx*0.12)*Math.sin(sy*0.12)+Math.sin((sx+sy)*0.08+t)*0.4+Math.sin(sx*0.06-sy*0.09+t*0.7)*0.3)*1.3)*0.25;\n  const coupling=rd1*rd2*0.3;\n  const blend=rd1*0.55+rd2*0.2+cell*0.15+coupling*0.1;\n  const v=blend*0.5+0.5;\n  const pal=[[6,12,52],[10,45,88],[15,88,115],[22,142,132],[38,178,118],[125,198,88],[215,192,58],[232,138,52],[212,82,62],[168,48,78],[108,28,68],[48,14,54],[6,12,52]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.82+Math.sin(rd1*Math.PI)*0.15+Math.abs(rd2)*0.03;\n  const edge=Math.abs(rd1)>0.65?1.12:(Math.abs(rd2)>0.7?1.08:1.0);\n  const glow=Math.max(0,1.0-Math.abs(blend)*2)*0.15;\n  return[Math.min(255,((pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*30)|0),Math.min(255,((pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*40)|0),Math.min(255,((pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*60)|0)];\n}",
