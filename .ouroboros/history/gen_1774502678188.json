  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x * 0.018 + t * 0.25) * 18 + Math.cos(y * 0.013 - t * 0.18) * 12;\n  const w1y = Math.cos(y * 0.017 - t * 0.22) * 16 + Math.sin(x * 0.015 + t * 0.3) * 11;\n  const w2x = Math.sin((x + y) * 0.009 + t * 0.15) * 8;\n  const w2y = Math.cos((x - y) * 0.008 - t * 0.12) * 7;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [160+Math.sin(t*0.5)*110, 80+Math.cos(t*0.35)*55, 0.075, 2.1, 1.0],\n    [320+Math.cos(t*0.45)*105, 160+Math.sin(t*0.6)*55, 0.09, 1.8, 0.9],\n    [240+Math.sin(t*0.28+2)*145, 120+Math.cos(t*0.42+1)*95, 0.055, 2.5, 1.1],\n    [100+Math.cos(t*0.7+1)*85, 190+Math.sin(t*0.55+3)*65, 0.11, 1.6, 0.85],\n    [370+Math.sin(t*0.38+4)*95, 55+Math.cos(t*0.8+2)*75, 0.065, 2.8, 1.05],\n    [240+Math.cos(t*0.32+5)*125, 210+Math.sin(t*0.48)*85, 0.085, 2.0, 0.95],\n    [60+Math.sin(t*0.55+3)*70, 50+Math.cos(t*0.65+4)*50, 0.1, 1.4, 0.8],\n    [420+Math.cos(t*0.42+1.5)*60, 200+Math.sin(t*0.38+2.5)*70, 0.07, 2.3, 1.15],\n    [180+Math.sin(t*0.33+5.5)*90, 30+Math.cos(t*0.52+0.5)*40, 0.12, 1.3, 0.75]\n  ];\n  let aS = 0, iS = 0, wS = 0;\n  for (const [sX, sY, f, sp, amp] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    const fade = 1.0 / (1.0 + d * 0.003);\n    aS += (Math.sin(d*f - t*sp) + Math.sin(d*f*1.618 - t*sp*0.618)) * 0.5 * amp * fade;\n    iS += (Math.sin(d*f*0.7 + t*sp*0.6 + 1.5) + Math.sin(d*f*0.433 + t*sp*0.381 + 3.0)) * 0.5 * amp * fade;\n    wS += Math.sin(d*f*0.5 - t*sp*0.5 + Math.sin(d*f*0.2)*2.0) * amp * fade * 0.3;\n  }\n  aS /= 9; iS /= 9; wS /= 9;\n  const bg1 = Math.sin(sx*0.035+sy*0.022+t*0.7);\n  const bg2 = Math.sin(sx*0.028-sy*0.038+t*1.0);\n  const bg3 = Math.sin((sx+sy)*0.11+t*2.3)*0.25;\n  const bg4 = Math.sin((sx-sy)*0.09-t*1.8)*0.25;\n  const bg5 = Math.sin(sx*0.06+sy*0.04-t*1.5)*Math.cos(sx*0.04-sy*0.05+t*0.9)*0.3;\n  const bg = (bg1+bg2)*0.35 + bg3 + bg4 + bg5;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cx, sx-cx);\n  const sp1 = Math.sin(dist*0.045-ang*3.5-t*1.4);\n  const sp2 = Math.sin(dist*0.035+ang*4.5-t*1.1);\n  const sp3 = Math.sin(dist*0.025-ang*2-t*0.8)*Math.cos(dist*0.05+ang*6-t*2.0);\n  const spiral = (sp1+sp2)*0.3 + sp3*0.25;\n  const diff = Math.tanh((aS - iS*0.65 + bg*0.25 + spiral + wS)*1.9);\n  const diff2 = Math.tanh((aS*0.8 - iS*0.5 + bg*0.4 - spiral*0.5)*1.5);\n  const cell = Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14) + Math.sin((sx+sy)*0.09+t)*0.6 + Math.sin(sx*0.07-t*0.5)*Math.cos(sy*0.08+t*0.3)*0.4)*1.3)*0.25;\n  const grain = (Math.sin(sx*12.9898+sy*78.233+t*43.0)*43758.5453 % 1) * 0.03;\n  const blend = diff*0.55 + diff2*0.2 + cell*0.25 + grain;\n  const v = blend*0.5+0.5;\n  const pal = [\n    [6,12,52],[10,38,88],[14,72,118],[18,110,130],\n    [35,155,140],[90,180,120],[170,195,75],\n    [220,175,55],[235,135,60],[220,85,70],\n    [185,50,75],[130,30,70],[75,22,65],[30,15,55],[6,12,52]\n  ];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const sm = f*f*(3-2*f);\n  const lum = 0.82 + Math.sin(Math.abs(diff)*Math.PI)*0.18;\n  const edge = Math.abs(diff)>0.65 ? 1.0 + (Math.abs(diff)-0.65)*0.5 : 1.0;\n  const glow = Math.max(0, 1.0 - Math.abs(diff)*0.8) * 0.15;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*sm)*lum*edge + glow*40)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*sm)*lum*edge + glow*25)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*sm)*lum*edge + glow*55)|0)\n  ];\n}",
