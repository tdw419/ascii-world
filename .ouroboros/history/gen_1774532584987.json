  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.015+t*0.3)*20 + Math.cos(y*0.012-t*0.2)*15;\n  const w1y = Math.cos(y*0.015-t*0.25)*20 + Math.sin(x*0.013+t*0.35)*15;\n  const w2x = Math.sin((x+w1x)*0.02+t*0.5)*10 + Math.cos((y+w1y)*0.018-t*0.4)*8;\n  const w2y = Math.cos((y+w1y)*0.02-t*0.45)*10 + Math.sin((x+w1x)*0.019+t*0.55)*8;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 1.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 0.8],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 1.2],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 0.9],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 1.1],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 0.7],\n    [80+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+2)*50, 0.11, 2.1, 1.3],\n    [400+Math.cos(t*0.55+1)*60, 220+Math.sin(t*0.75+4)*40, 0.13, 1.4, 0.6]\n  ];\n  let aS = 0, iS = 0, tw = 0;\n  for (const [sX, sY, f, sp, w] of src) {\n    const d = Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS += (Math.sin(d*f-t*sp)+Math.sin(d*f*1.5-t*sp*0.8+1.0)*0.5)*w;\n    iS += (Math.sin(d*f*0.7+t*sp*0.6+1.5)+Math.cos(d*f*1.2+t*sp*0.4-0.8)*0.4)*w;\n    tw += w;\n  }\n  aS /= tw; iS /= tw;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1)+Math.sin(sx*0.06+sy*0.01-t*0.6)*0.5)/2.5+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2+Math.sin(sx*0.08*Math.cos(t*0.2)+sy*0.07*Math.sin(t*0.15)+t*1.3)*0.15;\n  const dist = Math.sqrt((sx-cx)**2+(sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.07-ang*2+t*0.9)*0.5)*0.35;\n  const c2x = 240+Math.sin(t*0.2)*60, c2y = 120+Math.cos(t*0.15)*40;\n  const d2 = Math.sqrt((sx-c2x)**2+(sy-c2y)**2), a2 = Math.atan2(sy-c2y, sx-c2x);\n  const sp2 = (Math.sin(d2*0.06+a2*2-t*1.8)+Math.sin(d2*0.045-a2*5+t*1.1))*0.2;\n  const rd1 = Math.tanh((aS-iS*0.7+bg*0.3+spiral+sp2)*2.2);\n  const rd2 = Math.tanh((aS*0.8+iS*0.5-bg*0.4+sp2*1.5-spiral*0.3)*1.8);\n  const cell = Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+Math.sin((sx*0.7-sy*1.3)*0.12+t*0.7)*0.3)*1.5)*0.3;\n  const bl = rd1*0.55+cell*0.15+rd2*0.3, v = bl*0.5+0.5;\n  const pal = [[5,12,55],[12,45,95],[18,85,120],[25,140,130],[60,175,120],[140,190,80],[210,185,60],[220,140,55],[210,95,60],[185,65,75],[130,40,70],[70,25,60],[30,15,55],[5,12,55]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.75+Math.sin(rd1*Math.PI)*0.2+Math.abs(rd2)*0.1;\n  const edge = Math.abs(rd1)>0.7?1.2:(Math.abs(rd2)>0.6?1.1:1.0);\n  const vig = 1.0-Math.sqrt((x-240)**2+(y-120)**2)/500*0.3;\n  return [\n    Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge*vig)|0,\n    Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge*vig)|0,\n    Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge*vig)|0\n  ];\n}",
