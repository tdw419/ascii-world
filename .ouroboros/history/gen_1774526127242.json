  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const wx = Math.sin(x*0.018+t*0.28)*18 + Math.cos(y*0.013-t*0.22)*12 + Math.sin((x+y)*0.008+t*0.15)*8;\n  const wy = Math.cos(y*0.019-t*0.24)*16 + Math.sin(x*0.016+t*0.32)*11 + Math.cos((x-y)*0.009-t*0.18)*7;\n  const sx = x + wx, sy = y + wy;\n  const src = [\n    [160+Math.sin(t*0.55)*110, 75+Math.cos(t*0.38)*55, 0.075, 2.1, 1.0],\n    [320+Math.cos(t*0.48)*105, 165+Math.sin(t*0.65)*55, 0.095, 1.8, 0.9],\n    [240+Math.sin(t*0.28+2)*145, 115+Math.cos(t*0.45+1)*95, 0.055, 2.4, 1.1],\n    [115+Math.cos(t*0.75+1)*85, 185+Math.sin(t*0.58+3)*65, 0.115, 1.6, 0.85],\n    [365+Math.sin(t*0.38+4)*95, 55+Math.cos(t*0.85+2)*75, 0.065, 2.7, 1.05],\n    [240+Math.cos(t*0.32+5)*125, 205+Math.sin(t*0.52)*85, 0.085, 2.0, 0.95],\n    [80+Math.sin(t*0.42+3)*70, 50+Math.cos(t*0.62+4)*60, 0.1, 1.9, 0.88],\n    [400+Math.cos(t*0.33+6)*75, 200+Math.sin(t*0.47+2)*70, 0.07, 2.5, 1.08]\n  ];\n  let aS = 0, iS = 0, harm = 0;\n  for (const [sX, sY, f, sp, w] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    const w1 = Math.sin(d*f - t*sp)*w;\n    const w2 = Math.sin(d*f*0.618 + t*sp*0.5 + 0.8)*w*0.7;\n    aS += w1;\n    iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5)*w;\n    harm += w1*w2*0.5;\n  }\n  const act = aS/8, inh = iS/8;\n  const bg = (Math.sin(sx*0.035+sy*0.022+t*0.75) + Math.sin(sx*0.028-sy*0.038+t*1.05) + Math.sin(sx*0.05+t*0.5)*Math.cos(sy*0.045-t*0.4))/3\n    + Math.sin((sx+sy)*0.11+t*2.3)*0.18 + Math.sin((sx-sy)*0.09-t*1.8)*0.18;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.045-ang*3.5-t*1.4) + Math.sin(dist*0.038+ang*4.5-t*1.1) + Math.sin(dist*0.06-ang*2-t*2.2)*0.6)*0.33;\n  const turb = Math.sin(sx*0.08+t*1.2)*Math.cos(sy*0.07-t*0.9)*Math.sin((sx-sy)*0.05+t*0.7)*0.25;\n  const reaction = Math.tanh((act - inh*0.65 + bg*0.28 + spiral*0.35 + harm*0.4 + turb)*2.0);\n  const cell = Math.tanh((Math.sin(sx*0.14)*Math.sin(sy*0.14) + Math.sin((sx+sy)*0.095+t)*0.5 + Math.sin(sx*0.07-sy*0.11+t*0.6)*0.3)*1.4)*0.28;\n  const micro = Math.sin(sx*0.25+sy*0.18+t*3)*Math.cos(sx*0.2-sy*0.22-t*2.5)*0.12;\n  const blend = reaction*0.6 + cell*0.22 + micro*0.18, v = blend*0.5+0.5;\n  const pal = [\n    [5,12,52],[10,35,88],[12,65,118],[18,110,135],[25,155,148],\n    [75,185,145],[165,200,110],[210,195,80],[220,155,75],[215,105,65],\n    [185,65,60],[145,35,55],[90,18,52],[45,12,48],[5,12,52]\n  ];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const sm = f*f*(3-2*f);\n  const lum = 0.82+Math.sin(reaction*Math.PI)*0.18;\n  const edge = Math.abs(reaction)>0.65?1.0+Math.abs(reaction)*0.15:1.0;\n  const glow = Math.max(0, 1-Math.abs(reaction))*0.08;\n  return [\n    Math.min(255, ((pal[i][0]+(pal[i+1][0]-pal[i][0])*sm)*lum*edge + glow*60)|0),\n    Math.min(255, ((pal[i][1]+(pal[i+1][1]-pal[i][1])*sm)*lum*edge + glow*80)|0),\n    Math.min(255, ((pal[i][2]+(pal[i+1][2]-pal[i][2])*sm)*lum*edge + glow*120)|0)\n  ];\n}",
