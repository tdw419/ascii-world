  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.02+t*0.3)*15+Math.cos(y*0.015-t*0.2)*10;\n  const w1y = Math.cos(y*0.02-t*0.25)*15+Math.sin(x*0.018+t*0.35)*10;\n  const w2x = Math.sin((x+w1x)*0.025-t*0.4)*8+Math.cos((y+w1y)*0.03+t*0.3)*6;\n  const w2y = Math.cos((y+w1y)*0.025+t*0.35)*8+Math.sin((x+w1x)*0.028-t*0.45)*6;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9],\n    [80+Math.sin(t*0.45+1)*70,40+Math.cos(t*0.65+2)*50,0.11,2.1],\n    [400+Math.cos(t*0.55+3)*60,200+Math.sin(t*0.75+1)*40,0.09,1.8],\n    [240+Math.sin(t*0.25)*160,120+Math.cos(t*0.45+2)*100,0.05,2.8]\n  ];\n  let aS=0,iS=0;\n  for(const[sX,sY,f,sp]of src){const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);aS+=Math.sin(d*f-t*sp);iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5);}\n  const act=aS/9,inh=iS/9;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1))/2+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2+Math.sin(sx*0.08+sy*0.06-t*1.8)*0.15+Math.sin(sx*0.05-sy*0.07+t*1.5)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2))*0.4+Math.sin(dist*0.03-ang*5+t*0.8)*0.2+Math.sin(dist*0.06+ang*2-t*2.1)*0.15;\n  const c1=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5)*1.5)*0.3;\n  const c2=Math.tanh((Math.sin(sx*0.08+1)*Math.sin(sy*0.09+2)+Math.sin((sx-sy)*0.06-t*0.7)*0.4)*1.2)*0.2;\n  const r1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2);\n  const r2=Math.tanh((act*0.8+inh*0.3-bg*0.2+spiral*0.6)*1.8);\n  const fb=Math.sin(r1*r2*Math.PI*2+t*0.5)*0.3;\n  const blend=r1*0.5+c1*0.2+c2*0.1+fb*0.2,v=blend*0.5+0.5;\n  const pal=[[5,10,45],[10,40,85],[15,85,120],[20,140,130],[80,175,120],[180,190,80],[220,170,60],[210,120,60],[185,70,55],[140,40,65],[85,25,60],[40,15,55],[15,12,48],[5,10,45]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i,sf=f*f*(3-2*f);\n  const lum=0.8+Math.sin(r1*Math.PI)*0.2,edge=Math.abs(r1)>0.7?1.15:1.0,shimmer=1+Math.sin(ang*6+dist*0.08-t*3)*0.05;\n  return[Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*sf)*lum*edge*shimmer)|0,Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*sf)*lum*edge*shimmer)|0,Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*sf)*lum*edge*shimmer)|0];\n}",
