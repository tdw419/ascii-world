  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.018+t*0.3)*18 + Math.cos(y*0.013-t*0.22)*12;\n  const w1y = Math.cos(y*0.017-t*0.28)*18 + Math.sin(x*0.015+t*0.32)*12;\n  const w2x = Math.sin((x+w1x)*0.025+t*0.15)*8 + Math.cos((y+w1y)*0.02-t*0.18)*6;\n  const w2y = Math.cos((y+w1y)*0.023-t*0.12)*8 + Math.sin((x+w1x)*0.019+t*0.2)*6;\n  const sx = x+w1x+w2x, sy = y+w1y+w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100,80+Math.cos(t*0.4)*50,0.08,2.0,1.0],\n    [320+Math.cos(t*0.5)*100,160+Math.sin(t*0.7)*50,0.1,1.7,0.9],\n    [240+Math.sin(t*0.3+2)*140,120+Math.cos(t*0.5+1)*90,0.06,2.3,1.1],\n    [120+Math.cos(t*0.8+1)*80,180+Math.sin(t*0.6+3)*60,0.12,1.5,0.8],\n    [360+Math.sin(t*0.4+4)*90,60+Math.cos(t*0.9+2)*70,0.07,2.6,1.05],\n    [240+Math.cos(t*0.35+5)*120,200+Math.sin(t*0.55)*80,0.09,1.9,0.95],\n    [80+Math.sin(t*0.45+3)*70,40+Math.cos(t*0.65+1)*50,0.11,2.1,0.85],\n    [400+Math.cos(t*0.55+2)*60,200+Math.sin(t*0.75+4)*50,0.065,2.4,1.1],\n    [200+Math.sin(t*0.25+6)*100,220+Math.cos(t*0.45+3)*60,0.13,1.6,0.9],\n    [300+Math.cos(t*0.7+1)*80,30+Math.sin(t*0.5+5)*40,0.075,2.2,1.0]\n  ];\n  let aS=0,iS=0,aS2=0,iS2=0;\n  for(const[sX,sY,f,sp,amp]of src){\n    const d=Math.sqrt((sx-sX)**2+(sy-sY)**2);\n    aS+=Math.sin(d*f-t*sp)*amp; iS+=Math.sin(d*f*0.7+t*sp*0.6+1.5)*amp;\n    aS2+=Math.sin(d*f*1.6-t*sp*1.3+0.7)*amp*0.5; iS2+=Math.sin(d*f*1.2+t*sp*0.9+2.8)*amp*0.5;\n  }\n  const act=aS/10,inh=iS/10,act2=aS2/10,inh2=iS2/10;\n  const bg=(Math.sin(sx*0.04+sy*0.025+t*0.8)+Math.sin(sx*0.03-sy*0.04+t*1.1))/2+Math.sin((sx+sy)*0.12+t*2.5)*0.2+Math.sin((sx-sy)*0.1-t*2)*0.2+Math.sin(sx*0.07+t*1.8)*Math.cos(sy*0.06-t*1.4)*0.15;\n  const dist=Math.sqrt((sx-cx)**2+(sy-cy)**2),ang=Math.atan2(sy-cy,sx-cx);\n  const spiral=(Math.sin(dist*0.05-ang*3-t*1.5)+Math.sin(dist*0.04+ang*4-t*1.2)+Math.sin(dist*0.065-ang*2+t*0.9)*0.5)*0.35;\n  const r1=Math.tanh((act-inh*0.7+bg*0.3+spiral)*2.2);\n  const r2=Math.tanh((act2-inh2*0.6+bg*0.2-spiral*0.5)*2.8);\n  const cross=r1*r2*0.4+Math.tanh((r1+r2)*1.2)*0.3;\n  const cell=Math.tanh((Math.sin(sx*0.15)*Math.sin(sy*0.15)+Math.sin((sx+sy)*0.1+t)*0.5+Math.sin(sx*0.22-t*0.7)*Math.cos(sy*0.2+t*0.5)*0.3)*1.5)*0.3;\n  let detail=0,dx=sx,dy=sy;\n  for(let i=0;i<3;i++){detail+=Math.sin(dx*0.08+dy*0.06+i*1.5+t*0.5)*Math.cos(dx*0.05-dy*0.07+i*2.1-t*0.3)*(0.5**i);dx=dx*0.8+Math.sin(dy*0.1+t)*10;dy=dy*0.8+Math.cos(dx*0.1-t)*10;}\n  const blend=r1*0.45+r2*0.2+cross*0.15+cell*0.1+detail*0.1,v=blend*0.5+0.5;\n  const pal=[[5,10,45],[12,50,85],[18,95,105],[25,140,130],[80,175,120],[180,195,80],[220,180,60],[230,130,55],[200,80,65],[150,45,70],[90,25,65],[45,15,55],[5,10,45]];\n  const idx=v*(pal.length-1),i=Math.min(idx|0,pal.length-2),f=idx-i;\n  const lum=0.85+Math.sin(r1*Math.PI)*0.15+Math.cos(r2*Math.PI*0.5)*0.05;\n  const edge=Math.abs(r1)>0.65?1.12+Math.abs(r2)*0.05:1.0;\n  const glow=Math.max(0,1.0-Math.abs(blend))*0.3;\n  return[Math.min(255,(pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge+glow*30)|0,Math.min(255,(pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge+glow*20)|0,Math.min(255,(pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge+glow*40)|0];\n}",
