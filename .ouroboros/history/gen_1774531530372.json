  "code": "(x, y, t) => {\n  const cx = 240, cy = 120;\n  const w1x = Math.sin(x*0.015+t*0.3)*18 + Math.cos(y*0.012-t*0.2)*12;\n  const w1y = Math.cos(y*0.018-t*0.25)*16 + Math.sin(x*0.014+t*0.35)*11;\n  const w2x = Math.sin((x+w1x)*0.02-t*0.4)*8 + Math.cos((y+w1y)*0.025+t*0.3)*6;\n  const w2y = Math.cos((y+w1y)*0.022+t*0.35)*7 + Math.sin((x+w1x)*0.019-t*0.45)*5;\n  const sx = x + w1x + w2x, sy = y + w1y + w2y;\n  const src = [\n    [160+Math.sin(t*0.6)*100, 80+Math.cos(t*0.4)*50, 0.08, 2.0, 0.0],\n    [320+Math.cos(t*0.5)*100, 160+Math.sin(t*0.7)*50, 0.1, 1.7, 1.0],\n    [240+Math.sin(t*0.3+2)*140, 120+Math.cos(t*0.5+1)*90, 0.06, 2.3, 2.0],\n    [120+Math.cos(t*0.8+1)*80, 180+Math.sin(t*0.6+3)*60, 0.12, 1.5, 3.0],\n    [360+Math.sin(t*0.4+4)*90, 60+Math.cos(t*0.9+2)*70, 0.07, 2.6, 4.0],\n    [240+Math.cos(t*0.35+5)*120, 200+Math.sin(t*0.55)*80, 0.09, 1.9, 5.0],\n    [80+Math.sin(t*0.45+3)*70, 40+Math.cos(t*0.65+4)*50, 0.11, 2.1, 0.5],\n    [400+Math.cos(t*0.55+2)*60, 200+Math.sin(t*0.75+1)*55, 0.085, 1.8, 2.5],\n    [200+Math.sin(t*0.5+1)*110, 220+Math.cos(t*0.6+3)*70, 0.13, 1.6, 4.5],\n    [300+Math.cos(t*0.4+4)*85, 30+Math.sin(t*0.85+2)*65, 0.075, 2.4, 3.5]\n  ];\n  let aS = 0, iS = 0, a2 = 0;\n  for (const [sX, sY, f, sp, ph] of src) {\n    const d = Math.sqrt((sx-sX)**2 + (sy-sY)**2);\n    aS += Math.sin(d*f - t*sp + ph);\n    iS += Math.sin(d*f*0.7 + t*sp*0.6 + 1.5 + ph);\n    a2 += Math.sin(d*f*1.3 - t*sp*0.8 + ph*2) * Math.cos(d*f*0.5 + t*0.3);\n  }\n  const act = aS/10, inh = iS/10, act2 = a2/10;\n  const bg = (Math.sin(sx*0.04+sy*0.025+t*0.8) + Math.sin(sx*0.03-sy*0.04+t*1.1))/2 + Math.sin((sx+sy)*0.12+t*2.5)*0.2 + Math.sin((sx-sy)*0.1-t*2)*0.2 + Math.sin(sx*0.08*Math.cos(t*0.1)+sy*0.06*Math.sin(t*0.15)+t*0.7)*0.15;\n  const dist = Math.sqrt((sx-cx)**2 + (sy-cy)**2), ang = Math.atan2(sy-cy, sx-cx);\n  const spiral = (Math.sin(dist*0.05-ang*3-t*1.5) + Math.sin(dist*0.04+ang*4-t*1.2))*0.4 + Math.sin(dist*0.07-ang*5+t*0.8)*0.2 + Math.sin(dist*0.03+ang*2-t*2.2)*0.15;\n  const lap = (Math.sin((sx+1)*0.05)+Math.sin((sx-1)*0.05)+Math.sin(sy*0.05)+Math.sin((sy-1)*0.05)-4*Math.sin(sx*0.05+sy*0.05))*2;\n  const reaction = Math.tanh((act - inh*0.7 + act2*0.3 + bg*0.3 + spiral + lap*0.15)*2.2);\n  const cellPhase = Math.sin(sx*0.15)*Math.sin(sy*0.15) + Math.sin((sx+sy)*0.1+t)*0.5 + Math.sin(sx*0.2-sy*0.15+t*0.7)*0.3;\n  const cell = Math.tanh(cellPhase*1.5)*0.3;\n  const edge = 1.0 + (Math.abs(reaction)>0.75 ? 0.25 : 0) + (Math.abs(cell)>0.6 ? 0.1 : 0);\n  const blend = reaction*0.65 + cell*0.2 + act2*0.15;\n  const v = blend*0.5+0.5;\n  const pal = [[5,12,45],[12,45,85],[18,90,120],[25,155,145],[120,195,140],[210,200,80],[230,150,60],[200,90,65],[160,50,75],[90,25,65],[40,15,55],[5,12,45]];\n  const idx = v*(pal.length-1), i = Math.min(idx|0, pal.length-2), f = idx-i;\n  const lum = 0.85 + Math.sin(reaction*Math.PI)*0.15 + Math.sin(act2*Math.PI*0.5)*0.05;\n  return [\n    Math.min(255, (pal[i][0]+(pal[i+1][0]-pal[i][0])*f)*lum*edge)|0,\n    Math.min(255, (pal[i][1]+(pal[i+1][1]-pal[i][1])*f)*lum*edge)|0,\n    Math.min(255, (pal[i][2]+(pal[i+1][2]-pal[i][2])*f)*lum*edge)|0\n  ];\n}",
